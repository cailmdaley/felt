<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shuttle's launchd LaunchAgent is rendered by `shuttle daemon install`.
  Placeholders: __LABEL__, __SHUTTLE_BIN__, __SHUTTLE_RELEASE__, __LOG__,
  __SHUTTLE_STORES__, __SHUTTLE_STORES_FILE__, __PATH__, __PORT__, and
  __SSH_AUTH_SOCK__. The unrendered template is not a valid plist.

  __SHUTTLE_BIN__ is the absolute path to the Go CLI. __SHUTTLE_RELEASE__ is
  the Mix release directory. Launchd starts `shuttle daemon start --force`
  directly, and `--force` skips the already-running guard during a restart.

  Launchd starts with a near-empty environment. The daemon needs both `felt`
  for fiber data and `shuttle` for orchestration, so install captures the
  user's login PATH in a scrubbed login shell and renders it as __PATH__.
  `--path` overrides the captured value.

  Keep the Mix release and felt stores outside ~/Documents, ~/Desktop, and
  ~/Downloads. macOS TCC attributes file access to the responsible process in
  the launchd-spawned process tree. A Full Disk Access grant to an unrelated
  binary does not cover the daemon's file access, so protected paths can make
  the daemon crash or appear empty. install warns about both paths.

  The same TCC boundary is why the daemon must not start a tmux server (see
  docs/dev/dispatch.md, "tmux server ownership"): workers started beneath the
  daemon inherit its responsible-process boundary. Keep the tmux server owned
  by the user's session instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__SHUTTLE_BIN__</string>
        <string>daemon</string>
        <string>start</string>
        <string>--force</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SHUTTLE_RELEASE</key>
        <string>__SHUTTLE_RELEASE__</string>
        <!-- The user's real login PATH, captured at install time (see header). -->
        <key>PATH</key>
        <string>__PATH__</string>
        <!--
          SHUTTLE_PORT is normally absent (the daemon binds 4000). It exists so a
          SECOND, non-default instance can be supervised beside the real one —
          which is what makes the keep-alive path testable on a machine that is
          already running a daemon, instead of only renderable. The renderer
          drops this pair when no port is given.
        -->
        <key>SHUTTLE_PORT</key>
        <string>__PORT__</string>
        <!--
          Empty SHUTTLE_STORES selects the editable registry and clears any
          stale override inherited from launchd. --stores explicitly pins the
          list instead; Settings then reports the override as read-only.
        -->
        <key>SHUTTLE_STORES</key>
        <string>__SHUTTLE_STORES__</string>
        <key>SHUTTLE_STORES_FILE</key>
        <string>__SHUTTLE_STORES_FILE__</string>
        <!--
          SSH_AUTH_SOCK points at the user's PERSISTENT login ssh-agent (default
          ~/.ssh/agent.sock), NOT launchd's per-session Keychain agent. This is
          load-bearing for remote work: launchd hands the daemon a bare agent
          that only ever holds the default key, so credentials added to the real
          agent — notably a short-lived SSH certificate from a step-ca host
          (`step ssh login …`, see AGENTS.md) — are invisible to it. Without
          this, every fresh ssh the daemon makes to such a host fails auth: its own
          remote feed/tunnel can't connect, and a kanban Attach tab (which
          inherits this very SSH_AUTH_SOCK) opens and instantly dies. Override
          with the socket option if your agent uses another path.
        -->
        <key>SSH_AUTH_SOCK</key>
        <string>__SSH_AUTH_SOCK__</string>
        <!--
          SHUTTLE_LOG names the very file StandardOutPath/StandardErrorPath
          below redirect to — all three render from the same placeholder. It
          exists purely so the daemon can know where its own stdout lands:
          launchd never tells the process it supervises, and Shuttle.LogRotator
          has to be able to cap that file (unrotated, the hub's reached 343MB).
          Without it the rotator falls back to the platform default, which is
          right for a default install and wrong for a custom log path.
        -->
        <key>SHUTTLE_LOG</key>
        <string>__LOG__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__SHUTTLE_RELEASE__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG__</string>

    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
