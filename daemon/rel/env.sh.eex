# Release runtime environment.
#
# No Erlang distribution: the daemon is a single local node serving loopback
# HTTP — distribution would register a node name with epmd, and two daemons on
# one host (the real one plus an e2e run on a private SHUTTLE_PORT) would
# collide on that name. Costs the launcher's rpc-shaped verbs (stop, pid,
# remote), which nothing uses: lifecycle is signals + supervisors, reads are
# HTTP via the bin/shuttle shim.
export RELEASE_DISTRIBUTION=none
