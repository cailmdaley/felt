# Pinned versions for the EL8 daemon build toolchain.
#
# ONE source of truth, read by both workflows and by scripts/build-otp-el8.sh:
#   - .github/workflows/release.yml  builds the Linux daemon legs
#   - .github/workflows/ci.yml       warms the OTP cache on pushes to main
#
# Format: bare NAME=VALUE lines. Shell-sourceable, and appendable to $GITHUB_ENV
# once comments and blank lines are stripped (GITHUB_ENV rejects `#` lines).

# The build container. MUST match the `container:` image in release.yml's
# daemon matrix, which cannot read this file — a job's container is resolved
# before any step runs. Both workflows assert the two agree.
EL8_IMAGE=almalinux:8

# MUST stay on the same major as ci.yml's `otp-version: "28"`: CI compiles and
# tests the daemon against that major and the release ships this one, so a
# mismatch means the tested bytecode is not the shipped bytecode.
EL8_OTP_VERSION=28.5.0.6

# Elixir ships precompiled per OTP major; the asset name elixir-otp-28.zip in
# build-otp-el8.sh's sibling step must match EL8_OTP_VERSION's major.
EL8_ELIXIR_VERSION=1.19.6

# gh is absent from the almalinux:8 image and its RPM repo is not worth a GPG
# dance; the static tarball is all `gh release upload` needs.
EL8_GH_VERSION=2.100.0
