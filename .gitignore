# Binaries (root only, not internal/felt/)
/felt
/felt-linux
*.exe

# goreleaser
dist/

# Local state
.dots/

# IDE
.idea/
.vscode/
*.swp
.osgrep

# macOS
.DS_Store

# Build / cache artifacts
_build/
.mystra-cache/

# Generated assets
nanobanana-output/

# ── Shuttle daemon (Elixir/Mix) ──────────────────────────────────────────
# `_build/` and `dist/` above already cover Mix's build dir and ui/dist.
/deps/
/cover/
/doc/
/tmp/
erl_crash.dump
*.ez
shuttle-*.tar
# Built daemon release + its generated version module
# (bin/shuttle itself is the TRACKED shell shim that fronts the release)
/bin/rel/
/priv/ui/
/lib/shuttle/build_info.ex

# ── Shuttle UI (offline verification harness build output) ───────────────
ui/harness-dist/
ui/harness-board-dist/
# npm's tree, and the vite cache it writes here. `ui/.gitignore` covers ui/'s
# own copies; a `vite build` run from ui/ also writes node_modules/.vite at the
# REPO ROOT, which no rule reached — so it surfaced as untracked for anyone who
# built, and an over-broad `git add` would have swept the whole tree in.
node_modules/

# mkdocs build output
/site/

# ── Source artwork ───────────────────────────────────────────────────────
# Masters stay on disk, out of the pack; only the small derived assets ship.
# design/README.md says where each one is used and how to regenerate it.
/design/*.png

# ── Agent harness state ──────────────────────────────────────────────────
# Claude Code writes these into any checkout it works in. Untracked by nature
# and worthless to anyone else — worktrees/ alone was 74MB of stale second
# copies of this repo. Ignoring them here rather than in .git/info/exclude
# means a fresh clone is covered too. (The tracked `.claude/skills/` files sit
# beside these and are deliberately NOT matched.)
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/routines/.state/
**/.claude/scheduled_tasks.json
**/.claude/scheduled_tasks.lock
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
