#!/bin/sh
# shuttle-launch — (re)start the shuttle daemon respawn loop in tmux.
#
# Tracked source of truth for the loop that keeps the daemon alive on hosts
# without a supervisor — a Linux host with no systemd user session, typically an
# HPC login node. scripts/bootstrap.sh installs this to
# ~/.local/bin/shuttle-launch; daemon/lib/shuttle/remote_registry.ex invokes that
# installed copy over SSH to revive a dead remote daemon.
#
# Modes:
#   shuttle-launch          (re)create tmux session "shuttle-daemon" running
#                           `shuttle-launch --loop`
#   shuttle-launch --loop   the respawn loop itself (runs in the foreground)
#
# Repo resolution precedence: $SHUTTLE_DIR; else ~/.shuttle/repo (the state
# file scripts/bootstrap.sh writes at install time, so remote revival over SSH needs
# no env to find the bootstrapped checkout); else the script's own directory
# if it looks like <repo>/bin. Source checkouts contain bin/rel/bin/shuttled;
# fetched releases contain bin/shuttled. If none resolves, this exits loudly.
#
# The loop calls `shuttle daemon start --force` with exponential backoff:
# a daemon that exits in < 60s doubles the sleep (2s .. 300s cap); one that
# lived >= 60s resets it to 2s, so repeated crashes back off without slowing
# recovery after a healthy run.
#
# `--force` is load-bearing: bare `start` probes :4000 and halt(1)s if a
# daemon answers, which would busy-respawn during the documented
# "kill the :4000 listener to cycle" procedure. See scripts/bootstrap.sh.

set -u

# Guarantee the canonical CLI dir is on PATH for the daemon we launch. The
# daemon shells out to both `felt` and `shuttle`; on a fresh Debian-family host
# ~/.local/bin joins PATH only if it existed when the login profile ran, so a
# first bootstrap's respawn loop — or a bare SSH revival — can otherwise start
# a daemon that cannot find its CLIs (contract skew, dispatches held).
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH"; export PATH ;;
esac

SESSION=shuttle-daemon

release_dir() {
  if [ -x "$1/bin/rel/bin/shuttled" ]; then
    printf '%s\n' "$1/bin/rel"
  elif [ -x "$1/bin/shuttled" ]; then
    printf '%s\n' "$1"
  fi
}

resolve_repo() {
  if [ -n "${SHUTTLE_DIR:-}" ]; then
    printf '%s\n' "$SHUTTLE_DIR"
    return
  fi
  if [ -r "$HOME/.shuttle/repo" ]; then
    state_repo=$(head -n 1 "$HOME/.shuttle/repo")
    if [ -n "$state_repo" ] && [ -n "$(release_dir "$state_repo")" ]; then
      printf '%s\n' "$state_repo"
      return
    fi
  fi
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  candidate=$(dirname -- "$script_dir")
  if [ -n "$(release_dir "$candidate")" ]; then
    printf '%s\n' "$candidate"
  fi
}

REPO=$(resolve_repo)
SHUTTLE_RELEASE=""
[ -n "$REPO" ] && SHUTTLE_RELEASE=$(release_dir "$REPO")
[ -n "$SHUTTLE_RELEASE" ] || {
  echo "shuttle-launch: could not find a daemon release. Set \$SHUTTLE_DIR to its checkout or release path (or write that path to \$HOME/.shuttle/repo)." >&2
  exit 1
}

if [ "${1:-}" = "--loop" ]; then
  cd "$REPO" || exit 1
  # Durable daemon logging. Redirect the daemon's stdout+stderr to a file so
  # dispatch history survives tmux scrollback — a Linux host running this
  # respawn loop otherwise logs only to its pane, and a failed force-reopen
  # warning (or any crash reason) is lost the moment the pane rotates. Size-rotate at
  # 64MB keeping one previous generation, so the log remains bounded. Override
  # the path with $SHUTTLE_LOG.
  # 64MB is Shuttle.LogRotator's @default_max_bytes: this rotation and the
  # daemon's in-process one bound the same file by different means (here
  # between daemon processes with mv, there hourly inside a running daemon by
  # copytruncate), and two mechanisms disagreeing about "too big" is only
  # confusing. Keep the numbers together if you change either.
  LOG="${SHUTTLE_LOG:-$HOME/.shuttle/shuttle.log}"
  mkdir -p "$(dirname "$LOG")"
  # Export the resolved path, not just the override: Shuttle.LogRotator caps
  # this same file on an hourly timer (the mv below only fires between
  # respawns), and it must never rotate a different file than the one the loop
  # is appending to. The rendered plist/unit export SHUTTLE_LOG for the same
  # reason.
  export SHUTTLE_LOG="$LOG"
  backoff=2
  while :; do
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 67108864 ]; then
      mv -f "$LOG" "$LOG.1" 2>/dev/null || true
    fi
    # A foreign daemon can already be answering at this host's listen address —
    # a manually started release, or a tmux session that outlived this loop's
    # own. `shuttle daemon status` probes the daemon's listen address (a unix
    # socket on a shared host, loopback TCP otherwise) and treats a
    # bound-but-booting version response as alive. `--force` skips the start
    # health check, so without this probe the loop would crash into :eaddrinuse
    # every iteration. A booting listener is re-probed after five seconds; a
    # ready daemon gets the slower healthy cadence. An absent listener starts.
    if status=$(SHUTTLE_RELEASE="$SHUTTLE_RELEASE" shuttle daemon status 2>/dev/null); then
      if printf '%s\n' "$status" | grep -Eq '"ready"[[:space:]]*:[[:space:]]*false([,}])'; then
        echo "[respawn] $(date '+%Y-%m-%dT%H:%M:%S%z') daemon is bound but still booting; checking again in 5s" | tee -a "$LOG" >&2
        sleep 5
      else
        echo "[respawn] $(date '+%Y-%m-%dT%H:%M:%S%z') daemon already answering; standing down" | tee -a "$LOG" >&2
        sleep 300
      fi
      continue
    fi
    started=$(date +%s)
    echo "=== shuttle start $(date '+%Y-%m-%dT%H:%M:%S%z') ===" >> "$LOG"
    SHUTTLE_RELEASE="$SHUTTLE_RELEASE" shuttle daemon start --force >> "$LOG" 2>&1
    status=$?
    lived=$(( $(date +%s) - started ))
    [ "$lived" -ge 60 ] && backoff=2
    echo "[respawn] $(date '+%Y-%m-%dT%H:%M:%S%z') daemon exited (status=$status, lived=${lived}s); restarting in ${backoff}s" | tee -a "$LOG" >&2
    sleep "$backoff"
    if [ "$lived" -lt 60 ]; then
      backoff=$(( backoff * 2 ))
      [ "$backoff" -gt 300 ] && backoff=300
    fi
  done
fi

# (Re)create the tmux session running this script's own loop mode.
SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")

# Both paths are embedded single-quoted in the tmux command string below; a
# single quote inside either would silently truncate the command while tmux
# still reports success. Refuse loudly instead of failing invisibly.
case "$REPO$SELF" in
  *"'"*)
    echo "shuttle-launch: repo or script path contains a single quote ($REPO, $SELF); refusing to embed it in the tmux command" >&2
    exit 1
    ;;
esac

# Clear this session from both tmux sockets before creating it on the default
# socket. A competing shuttle-daemon session could otherwise bind :4000 first.
# The commands are sequential so a miss on one socket doesn't short-circuit the other.
#
# Killing the session SIGHUPs the daemon, which dies without running its
# shutdown (no init:stop), so mark the stop as asked-for first: the stop marker
# tells the next boot to hold its quarantine (Shuttle.DaemonHeartbeat). It
# lives in the data directory `shuttle host --json` reports as data_dir
# ($SHUTTLE_DATA_DIR trimmed, a leading ~ expanded, as the daemon resolves it);
# without a shuttle CLI that reports it, the plain expansion. A missing data
# dir means no daemon has run here, and the touch just fails.
data_dir=""
if command -v shuttle >/dev/null 2>&1; then
  data_dir=$(SHUTTLE_RELEASE="$SHUTTLE_RELEASE" shuttle host --json 2>/dev/null | sed -n 's/.*"data_dir": *"\([^"]*\)".*/\1/p' | head -n 1)
fi
touch "${data_dir:-${SHUTTLE_DATA_DIR:-$HOME/.shuttle}}/heartbeat.stopped" 2>/dev/null
tmux -S "$HOME/.shuttle/tmux.sock" kill-session -t "$SESSION" 2>/dev/null
tmux kill-session -t "$SESSION" 2>/dev/null
tmux new-session -d -s "$SESSION" \
  "SHUTTLE_DIR='$REPO' '$SELF' --loop" \
  || { echo "shuttle-launch: failed to start tmux session '$SESSION'" >&2; exit 1; }
echo "shuttle-launch: respawn loop running in tmux session '$SESSION' (repo: $REPO)"
