#!/usr/bin/env node
import { execFileSync, spawn } from 'node:child_process'
import { constants } from 'node:fs'
import { access, chmod, mkdir, readFile, readdir, rename, rm, stat, writeFile } from 'node:fs/promises'
import { homedir } from 'node:os'
import { delimiter, dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { randomUUID } from 'node:crypto'

const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..')
const port = Number(process.env.SHARED_BROWSER_PORT || 9333)
const stateDir = resolve(process.env.XDG_STATE_HOME || join(homedir(), '.local', 'state'), 'shared-browser')
const profileDir = join(stateDir, `profile-${port}`)
const stateFile = join(stateDir, `browser-${port}.json`)
const lockDir = join(stateDir, `browser-${port}.lock`)
const portArg = `--remote-debugging-port=${port}`
// Keep playback muted and route password storage away from the login keychain.
const baseArgs = [
  portArg,
  '--remote-debugging-address=127.0.0.1',
  '--remote-allow-origins=*',
  '--headless=new',
  `--user-data-dir=${profileDir}`,
  '--allow-file-access-from-files',
  '--autoplay-policy=no-user-gesture-required',
  '--mute-audio',
  '--no-first-run',
  '--no-default-browser-check',
  '--no-startup-window',
  '--disable-background-networking',
  '--disable-sync',
  '--disable-component-update',
  ...(process.platform === 'darwin' ? ['--use-mock-keychain'] : []),
  ...(process.platform === 'linux' ? ['--password-store=basic'] : []),
]

if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error(`Invalid SHARED_BROWSER_PORT: ${port}`)

const sleep = ms => new Promise(resolve => setTimeout(resolve, ms))

function processes() {
  const output = execFileSync('ps', ['-ww', '-axo', 'pid=,ppid=,pgid=,rss=,command='], { encoding: 'utf8' })
  return output.split('\n').flatMap(line => {
    const match = line.match(/^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(.*)$/)
    return match ? [{ pid: +match[1], ppid: +match[2], pgid: +match[3], rssKiB: +match[4], command: match[5] }] : []
  })
}

function chromeProcess(item) {
  return /chrome|chromium/i.test(item.command)
}

function findBrowserPid(list) {
  const candidates = list.filter(item => item.command.includes(portArg) && chromeProcess(item))
  return candidates.find(item => !/(?:^|\s)--type=/.test(item.command))?.pid ?? candidates[0]?.pid ?? null
}

function validBrowserPid(pid, list) {
  const item = list.find(candidate => candidate.pid === pid)
  return Boolean(item && chromeProcess(item) && item.command.includes(portArg))
}

function processTree(root, list) {
  if (!root) return []
  const children = new Map()
  for (const item of list) children.set(item.ppid, [...(children.get(item.ppid) ?? []), item])
  const tree = [], pending = [root], seen = new Set()
  while (pending.length) {
    const pid = pending.pop()
    if (seen.has(pid)) continue
    seen.add(pid)
    const item = list.find(candidate => candidate.pid === pid)
    if (item) tree.push(item)
    pending.push(...(children.get(pid) ?? []).map(child => child.pid))
  }
  return tree
}

function treeSnapshot(pid, list, launchedByScript = false) {
  const tree = processTree(pid, list)
  if (launchedByScript && list.some(item => item.pid === pid && item.pgid === pid)) {
    const seen = new Set(tree.map(item => item.pid))
    for (const item of list) if (item.pgid === pid && !seen.has(item.pid)) tree.push(item)
  }
  return { processCount: tree.length, rssKiB: tree.reduce((sum, item) => sum + item.rssKiB, 0) }
}

function processExecutable(command) {
  const match = command.match(/^(?:"([^"]+)"|'([^']+)'|(\S+))/)
  return match?.[1] ?? match?.[2] ?? match?.[3] ?? null
}

function browserPid(state, list = processes()) {
  const detected = findBrowserPid(list)
  return detected ?? (validBrowserPid(state?.pid, list) ? state.pid : null)
}

async function json(path) {
  try {
    const response = await fetch(`http://127.0.0.1:${port}${path}`, { signal: AbortSignal.timeout(750) })
    return response.ok ? await response.json() : null
  } catch {
    return null
  }
}

function endpointFrom(version) {
  try {
    const endpoint = new URL(version?.webSocketDebuggerUrl)
    if (endpoint.protocol !== 'ws:' || !['127.0.0.1', 'localhost', '::1', '[::1]'].includes(endpoint.hostname)) return null
    if (endpoint.port && Number(endpoint.port) !== port) return null
    endpoint.hostname = '127.0.0.1'
    endpoint.port = String(port)
    return endpoint.toString()
  } catch {
    return null
  }
}

async function probe() {
  const version = await json('/json/version')
  const endpoint = endpointFrom(version)
  return endpoint ? { endpoint, version } : null
}

const targetId = target => target?.id || target?.targetId || null
const blankTarget = targets => targets?.find(target => target.type === 'page' && target.url === 'about:blank')
// Chromium exposes its New Tab screen as page, iframe, and browser UI targets.
const idleTarget = target => {
  const url = target.url ?? ''
  if (target.type === 'page') return url.startsWith('about:blank') || url === 'chrome://newtab/'
  return target.type === 'browser_ui' || target.type === 'iframe' && url.startsWith('chrome-untrusted://new-tab-page/')
}

async function readState() {
  try {
    const state = JSON.parse(await readFile(stateFile, 'utf8'))
    return state.port === port ? state : null
  } catch {
    return null
  }
}

async function saveState(state) {
  const temporary = `${stateFile}.${process.pid}.${randomUUID()}.tmp`
  await writeFile(temporary, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 })
  await rename(temporary, stateFile)
}

async function removeState() {
  await rm(stateFile, { force: true })
}

function pidAlive(pid) {
  try {
    process.kill(pid, 0)
    return true
  } catch (error) {
    return error.code === 'EPERM'
  }
}

async function withLock(action) {
  await mkdir(stateDir, { recursive: true, mode: 0o700 })
  await chmod(stateDir, 0o700)
  const started = Date.now(), token = randomUUID()
  let locked = false
  while (Date.now() - started < 30_000) {
    try {
      await mkdir(lockDir, { mode: 0o700 })
      await writeFile(join(lockDir, 'owner.json'), JSON.stringify({ pid: process.pid, token }), { mode: 0o600 })
      locked = true
      break
    } catch (error) {
      if (error.code !== 'EEXIST') throw error
      let owner
      try { owner = JSON.parse(await readFile(join(lockDir, 'owner.json'), 'utf8')) } catch {}
      let stale = owner ? !pidAlive(Number(owner.pid)) : false
      if (!owner) {
        try { stale = Date.now() - (await stat(lockDir)).mtimeMs > 30_000 } catch { stale = true }
      }
      if (stale) {
        const abandoned = `${lockDir}.stale-${process.pid}-${randomUUID()}`
        try { await rename(lockDir, abandoned); await rm(abandoned, { recursive: true, force: true }) } catch {}
      }
      if (Date.now() - started >= 30_000) throw new Error(`Timed out waiting for ${lockDir}`)
      await sleep(100)
    }
  }
  if (!locked) throw new Error(`Timed out waiting for ${lockDir}`)
  try {
    return await action()
  } finally {
    try {
      const owner = JSON.parse(await readFile(join(lockDir, 'owner.json'), 'utf8'))
      if (owner.token === token) await rm(lockDir, { recursive: true, force: true })
    } catch {}
  }
}

async function executable(path) {
  try { await access(path, constants.X_OK); return true } catch { return false }
}

async function directories(path) {
  try {
    return (await readdir(path, { withFileTypes: true })).filter(entry => entry.isDirectory()).map(entry => entry.name)
  } catch {
    return []
  }
}

function layouts(versionDir) {
  if (process.platform === 'darwin') return [
    'chrome-mac-arm64', 'chrome-mac-x64', 'chrome-mac',
  ].flatMap(folder => [
    join(versionDir, folder, 'Google Chrome for Testing.app', 'Contents', 'MacOS', 'Google Chrome for Testing'),
    join(versionDir, folder, 'Chromium.app', 'Contents', 'MacOS', 'Chromium'),
  ])
  if (process.platform === 'linux') return [join(versionDir, 'chrome-linux64', 'chrome'), join(versionDir, 'chrome-linux', 'chrome')]
  return []
}

async function cachedBrowser(root, buckets) {
  for (const bucket of buckets) {
    const versions = (await directories(join(root, bucket))).sort((a, b) => b.localeCompare(a, undefined, { numeric: true }))
    for (const version of versions) {
      for (const candidate of layouts(join(root, bucket, version))) if (await executable(candidate)) return candidate
    }
  }
  return null
}

async function findBrowser() {
  const puppeteerRoots = [process.env.PUPPETEER_CACHE_DIR, join(homedir(), '.cache', 'puppeteer'), join(homedir(), 'Library', 'Caches', 'puppeteer')].filter(Boolean)
  for (const root of new Set(puppeteerRoots)) {
    const candidate = await cachedBrowser(root, ['chrome'])
    if (candidate) return candidate
  }

  const cftApps = process.platform === 'darwin' ? [
    join(homedir(), 'Applications', 'Google Chrome for Testing.app', 'Contents', 'MacOS', 'Google Chrome for Testing'),
    '/Applications/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing',
  ] : []
  const cftCommands = process.platform === 'linux' ? ['google-chrome-for-testing', 'chrome-for-testing'] : []
  for (const directory of (process.env.PATH || '').split(delimiter)) {
    for (const command of cftCommands) cftApps.push(join(directory, command))
  }
  for (const candidate of cftApps) if (await executable(candidate)) return candidate

  const playwrightRoots = [
    process.env.PLAYWRIGHT_BROWSERS_PATH === '0' ? join(repoRoot, 'ui', 'node_modules', 'playwright-core', '.local-browsers') : process.env.PLAYWRIGHT_BROWSERS_PATH,
    join(homedir(), '.cache', 'ms-playwright'),
    join(homedir(), 'Library', 'Caches', 'ms-playwright'),
  ].filter(Boolean)
  for (const root of new Set(playwrightRoots)) {
    const candidate = await cachedBrowser(root, ['chromium', 'chrome'])
    if (candidate) return candidate
  }

  if (process.env.CHROME_PATH) {
    if (await executable(process.env.CHROME_PATH)) return resolve(process.env.CHROME_PATH)
    throw new Error(`CHROME_PATH is not an executable browser: ${process.env.CHROME_PATH}`)
  }
  const systemApps = process.platform === 'darwin' ? [
    join(homedir(), 'Applications', 'Google Chrome.app', 'Contents', 'MacOS', 'Google Chrome'),
    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    join(homedir(), 'Applications', 'Chromium.app', 'Contents', 'MacOS', 'Chromium'),
    '/Applications/Chromium.app/Contents/MacOS/Chromium',
  ] : []
  const systemCommands = ['google-chrome-stable', 'google-chrome', 'chromium', 'chromium-browser', 'chrome']
  const pathApps = (process.env.PATH || '').split(delimiter).flatMap(directory => systemCommands.map(command => join(directory, command)))
  for (const candidate of [...systemApps, ...pathApps]) if (await executable(candidate)) return candidate
  throw new Error('No Chrome for Testing, CHROME_PATH browser, or system Chrome/Chromium was found')
}

async function stopPid(pid, state, list = processes()) {
  const group = list.filter(item => item.pgid === pid)
  const ownGroup = state?.launchedByScript && group.some(item => chromeProcess(item)
    && (item.command.includes(portArg) || item.command.includes(`--user-data-dir=${profileDir}`)))
  const tree = processTree(pid, list)
  if (!validBrowserPid(pid, list) && !ownGroup) return false
  const signal = name => {
    if (ownGroup) {
      try { process.kill(-pid, name); return } catch {}
    }
    for (const item of [...tree].reverse()) try { process.kill(item.pid, name) } catch {}
  }
  signal('SIGTERM')
  const deadline = Date.now() + 5_000
  while (Date.now() < deadline) {
    const current = processes()
    const alive = ownGroup ? current.some(item => item.pgid === pid) : processTree(pid, current).length > 0
    if (!alive) return true
    await sleep(100)
  }
  signal('SIGKILL')
  await sleep(150)
  return true
}

async function ensureStarted() {
  const health = await probe(), state = await readState()
  if (health) {
    const list = processes(), pid = browserPid(state, list), targets = await json('/json/list')
    const ownsProcess = state?.pid === pid && state.launchedByScript === true
    const next = {
      ...state,
      port,
      pid,
      endpoint: health.endpoint,
      browserPath: ownsProcess ? state.browserPath : (pid ? processExecutable(list.find(item => item.pid === pid).command) : null),
      userDataDir: ownsProcess ? state.userDataDir : null,
      launchedByScript: ownsProcess,
      startedAt: state?.startedAt ?? new Date().toISOString(),
      lastUsedAt: Date.now(),
      defaultTargetId: state?.defaultTargetId ?? targetId(blankTarget(targets)),
    }
    await saveState(next)
    return next
  }

  const list = processes()
  if (validBrowserPid(state?.pid, list) || state?.launchedByScript && list.some(item => item.pgid === state.pid)) {
    await stopPid(state.pid, state, list)
  }
  await removeState()
  await mkdir(profileDir, { recursive: true, mode: 0o700 })
  await chmod(profileDir, 0o700)
  const browserPath = await findBrowser()
  const args = [...baseArgs]
  if (typeof process.getuid === 'function' && process.getuid() === 0) args.push('--no-sandbox')
  const child = spawn(browserPath, args, { detached: true, stdio: 'ignore' })
  await new Promise((resolve, reject) => { child.once('spawn', resolve); child.once('error', reject) })
  child.unref()

  const next = {
    port, pid: child.pid, endpoint: null, browserPath, userDataDir: profileDir,
    launchedByScript: true, startedAt: new Date().toISOString(), lastUsedAt: Date.now(), defaultTargetId: null,
  }
  await saveState(next)
  const ready = await waitForBrowser(child.pid)
  if (!ready) {
    await stopPid(child.pid, next)
    await removeState()
    throw new Error(`Chrome did not become healthy at http://127.0.0.1:${port}/json/version`)
  }
  next.endpoint = ready.endpoint
  next.defaultTargetId = targetId(blankTarget(await json('/json/list')))
  await saveState(next)
  return next
}

async function waitForBrowser(pid) {
  const until = Date.now() + 30_000
  while (Date.now() < until) {
    const health = await probe()
    if (health) return health
    if (!pidAlive(pid)) break
    await sleep(150)
  }
  return null
}

async function start() {
  return withLock(async () => (await ensureStarted()).endpoint)
}

async function endpoint() {
  return withLock(async () => {
    const state = await ensureStarted()
    state.lastUsedAt = Date.now()
    await saveState(state)
    return state.endpoint
  })
}

async function status() {
  const health = await probe(), state = await readState(), list = processes()
  const pid = health ? browserPid(state, list) : null
  const snapshot = treeSnapshot(pid, list, state?.launchedByScript === true)
  return {
    running: Boolean(health), pid, endpoint: health?.endpoint ?? null,
    browserPath: state?.browserPath ?? null,
    processCount: snapshot.processCount, rssKiB: snapshot.rssKiB,
    rssMiB: Number((snapshot.rssKiB / 1024).toFixed(1)), lastUsedAt: state?.lastUsedAt ?? null,
  }
}

async function stop() {
  return withLock(async () => {
    const state = await readState(), list = processes(), pid = browserPid(state, list)
    if (pid) await stopPid(pid, state, list)
    await removeState()
    return pid !== null
  })
}

async function reap(value) {
  const minutes = Number(value ?? process.env.SHARED_BROWSER_IDLE_MINUTES ?? 30)
  if (!Number.isFinite(minutes) || minutes < 0) throw new Error(`Idle minutes must be non-negative; received ${value}`)
  return withLock(async () => {
    if (!await probe()) { await removeState(); return { result: 'not running' } }
    let state = await readState()
    if (!state) state = await ensureStarted()
    const targets = await json('/json/list')
    if (!Array.isArray(targets)) return { result: 'could not inspect CDP targets' }
    if (!state.defaultTargetId && targets.length === 1) {
      state.defaultTargetId = targetId(blankTarget(targets))
      if (state.defaultTargetId) await saveState(state)
    }
    const idleTargetsOnly = targets.every(idleTarget)
    const idleForMs = Date.now() - Number(state.lastUsedAt || Date.now())
    if (!idleTargetsOnly || idleForMs < minutes * 60_000) return { result: 'active', targetCount: targets.length, idleForMs }
    const list = processes(), pid = browserPid(state, list)
    if (pid) await stopPid(pid, state, list)
    await removeState()
    return { result: 'reaped', pid }
  })
}

function formatRss(kib) {
  return kib >= 1024 * 1024 ? `${(kib / 1024 / 1024).toFixed(2)} GiB` : `${(kib / 1024).toFixed(1)} MiB`
}

async function main() {
  const [command, ...args] = process.argv.slice(2)
  if (command === 'start') console.log(await start())
  else if (command === 'endpoint') console.log(await endpoint())
  else if (command === 'status') {
    const current = await status()
    if (args.includes('--json')) console.log(JSON.stringify(current, null, 2))
    else {
      console.log(`status: ${current.running ? 'running' : 'stopped'}`)
      console.log(`pid: ${current.pid ?? 'none'}`)
      console.log(`endpoint: ${current.endpoint ?? 'none'}`)
      console.log(`processes: ${current.processCount}`)
      console.log(`RSS: ${formatRss(current.rssKiB)}`)
      if (current.browserPath) console.log(`browser: ${current.browserPath}`)
    }
  } else if (command === 'stop') console.log(await stop() ? 'stopped' : 'not running')
  else if (command === 'reap') {
    const result = await reap(args[0])
    console.log(result.result === 'reaped' ? `reaped pid ${result.pid ?? 'unknown'}`
      : result.result === 'active' ? `active: ${result.targetCount} CDP target(s), idle ${Math.floor(result.idleForMs / 60_000)}m` : result.result)
  } else console.log('Usage: bin/shared-browser <start|endpoint|status|stop|reap [idle-minutes]>')
}

main().catch(error => { console.error(`shared-browser: ${error.message}`); process.exitCode = 1 })
