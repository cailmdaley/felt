#!/usr/bin/env bash
#
# shuttle-deploy — one verb, whole fleet. Push, rebuild, cycle, verify, release.
#
#   bin/shuttle-deploy                        # deploy everywhere (local + all remotes)
#   bin/shuttle-deploy --hosts local,hub-a    # a subset
#   bin/shuttle-deploy --list                 # show the host table
#   bin/shuttle-deploy --no-push              # skip the git push (already pushed)
#   bin/shuttle-deploy --ref v2.0.0-rc.1      # build an exact revision in immutable worktrees
# Targets must support incarnation-bound release (e8fc948a or a descendant).
# Older revisions are not automated rollback targets; release stays held.
#
#   bin/shuttle-deploy --handshake            # bootstrap interactive ssh auth when
#                                             # no live master — human must approve
#
# Each run resolves one commit. Under a host lock it prepares a detached root,
# builds, refreshes harnesses, activates, verifies and releases quarantine.
# A per-tree kernel lease protects preparation and builds from pruning.
# Hosts already serving the ready target coalesce without another cycle.
# A host whose harness plugins disagree with its felt build fails after its daemon
# step has run. Each host builds its CLI and daemon using its login-shell
# environment, and its UI too unless it is marked `"build_ui": false` — see the
# bundle note below. The operator agent registry is synced too: the board reads
# the local registry, while owner-routed mutations resolve agents on the
# owning host.
#
# The fleet is NOT written here. It comes from ~/.config/shuttle/remotes.json
# (`SHUTTLE_REMOTES_FILE` overrides) — the same file the daemon and `shuttle
# remotes` read. Deploy uses six of its per-remote keys: `ssh` (destination,
# defaults to the name), `checkout` (repo path on that host), `ssh_flags`
# (extra ssh arguments), `auth` ("interactive" marks a host that needs a live
# human credential), `enabled`, and `build_ui`. A remote without `checkout` is
# not a deploy target and is skipped. "local" is always in the fleet; a missing
# fleet file means local only. Portable to macOS bash 3.2 (no assoc arrays).
#
# `"build_wrap": "srun -p serial --cpus-per-task=8"` prefixes only the build
# with that command and bash -lc; pull, preparation, refresh and cycle run outside it.
# `"build_ui": false` marks a host that must not build the board bundle. On a
# cluster login node `npm ci` against a network home filesystem costs minutes
# and `vite build` several more, for a bundle that is identical everywhere. Such
# a host is built with `make build SKIP_UI=1`, and this script ships the deploy
# host's own freshly-built ui/dist to its checkout instead. The rsync happens
# BEFORE the remote build, because the release assembled by `make daemon` copies
# ui/dist into its priv/ — and the daemon serves the release's copy in
# preference to the checkout's, so a bundle that lands after the build would not
# be the one served.

# Read the entrypoint once: a checkout refresh or editor must not replace bytes
# Bash has yet to read while an earlier host is building.
if [ -n "${BASH_SOURCE[0]:-}" ] && [ "${BASH_SOURCE[0]}" = "$0" ]; then
  exec bash -c "$(<"$0")" "$0" "$@"
fi

set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h|--help) sed -n '2,43p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  esac
done

supervisor_probe_cmd() {
  cat <<'SH'
# A live respawn loop is the selected owner even if a stale unit file exists.
if "$HOME/.local/bin/shuttle" daemon loop-present >/dev/null 2>&1; then
  echo tmux
  exit 0
fi
for candidate in "$HOME"/Library/LaunchAgents/*.plist; do
  [ -f "$candidate" ] || continue
  grep -q 'io.shuttle.daemon' "$candidate" || continue
  label=$(basename "$candidate" .plist)
  if launchctl print "gui/$(id -u)/$label" 2>/dev/null | grep -Eq '^[[:space:]]*pid = [1-9][0-9]*$'; then echo 1; exit 0; fi
done
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  for candidate in "$HOME"/.config/systemd/user/*.service; do
    [ -f "$candidate" ] || continue
    if grep -q 'shuttle' "$candidate" && { grep -Eq 'start([[:space:]]|$)' "$candidate" || grep -q 'SHUTTLE_RELEASE' "$candidate"; } && systemctl --user is-active --quiet "$(basename "$candidate" .service)" 2>/dev/null; then echo 1; exit 0; fi
  done
fi
echo 0
SH
}

respawn_launcher_restart_cmd() {
  local checkout="$1" owner="${2:-}" mode=""
  [ "$owner" != tmux ] || mode="--tmux"
  cat <<SH
set -eu
mkdir -p "\$HOME/.shuttle" "\$HOME/.local/bin"
install -m 755 $(shell_quote "$checkout/bin/shuttle-launch") "\$HOME/.local/bin/shuttle-launch"
PATH="\$HOME/.local/bin:\$PATH"
export PATH
"\$HOME/.local/bin/shuttle-launch" $mode
SH
}

config_migration_cmd() {
  cat <<'SH'
set -eu
old="$HOME/.config/felt"
new="$HOME/.config/shuttle"
for name in host.json remotes.json agents.json stores.json projects.json; do
  if [ -f "$old/$name" ] && [ ! -e "$new/$name" ] && [ ! -L "$new/$name" ]; then
    mkdir -p "$new"
    cp -p "$old/$name" "$new/$name"
  fi
done
SH
}

# Move the deploy host's config before reading its fleet file. The same
# idempotent move runs on each remote after its new CLI and release are built.
bash -lc "$(config_migration_cmd)" || { echo "shuttle-deploy: config migration failed on the deploy host" >&2; exit 1; }

FLEET_FILE="${SHUTTLE_REMOTES_FILE:-$HOME/.config/shuttle/remotes.json}"
AGENTS_FILE="${SHUTTLE_AGENTS_FILE:-$HOME/.config/shuttle/agents.json}"

# The fleet file rendered as TSV: name, ssh destination, checkout, auth, flags,
# build_ui ("1"/"0"), build_wrap. jq if it is installed, python3 otherwise — the file is read
# on the deploy host only, so this needs no remote-side dependency. Both accept
# either document shape the Go and Elixir readers accept: {"remotes": [...]} or a
# bare list, and both must agree field for field: only a literal `false` turns
# `enabled` or `build_ui` off, exactly as the Go reader's `enabledOr` does.
read_fleet() {
  [ -f "$FLEET_FILE" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '(if type == "array" then . else .remotes end // [])
           | .[]
           | select(.enabled != false)
           | select((.checkout // "") != "")
           | [.name, (.ssh // .name), .checkout, (.auth // "pubkey"),
              ((.ssh_flags // []) | join(" ")),
              (if .build_ui == false then "0" else "1" end), (.build_wrap // "")]
           | @tsv' "$FLEET_FILE"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$FLEET_FILE" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
for r in (doc if isinstance(doc, list) else doc.get("remotes") or []):
    if r.get("enabled") is False or not r.get("checkout"):
        continue
    print("\t".join([r.get("name", ""), r.get("ssh") or r.get("name", ""),
                     r["checkout"], r.get("auth") or "pubkey",
                     " ".join(r.get("ssh_flags") or []),
                     "0" if r.get("build_ui") is False else "1", r.get("build_wrap") or ""]))
PY
  else
    echo "shuttle-deploy: need jq or python3 to read $FLEET_FILE" >&2
    return 1
  fi
}

FLEET_TSV="$(read_fleet)" || exit 1
FLEET_ORDER="local $(printf '%s\n' "$FLEET_TSV" | awk -F'\t' 'NF {print $1}' | tr '\n' ' ')"

fleet_row() { printf '%s\n' "$FLEET_TSV" | awk -F'\t' -v h="$1" 'NF && $1 == h'; }
fleet_dir() { # host → checkout dir (empty = unknown host)
  [ "$1" = local ] && { echo "$REPO"; return; }
  fleet_row "$1" | awk -F'\t' '{print $3}'
}
fleet_ssh()   { fleet_row "$1" | awk -F'\t' '{print $2}'; }   # ssh destination
fleet_flags() { # Dead-link bounds apply to probes and transfers as well as work.
  printf '%s ' '-o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=3'
  fleet_row "$1" | awk -F'\t' '{print $5}'
}
fleet_auth()  { fleet_row "$1" | awk -F'\t' '{print $4}'; }   # pubkey | interactive
fleet_build_wrap() { fleet_row "$1" | awk -F'\t' '{print $7}'; }
builds_ui()   { [ "$(fleet_row "$1" | awk -F'\t' '{print $6}')" != 0 ]; }

# Hosts whose ssh needs an interactive human credential (push-2FA, short-lived
# certificates) get a handshake verb: when the preflight finds no live
# connection, we can BOOTSTRAP one instead of failing — provided a human is
# around to approve it. Mark such a host `"auth": "interactive"` in the fleet
# file. A fresh master connection prompts (a push-2FA host asks "Passcode or
# option (1-1)"); answering fires a push to the operator's device, typically
# with a ~60s timeout. The ritual: open `ssh <host>` in a throwaway tmux
# session, send the reply, wait for `ssh -O check` to report a live
# ControlMaster (the ssh config's ControlMaster auto + ControlPersist keeps it
# alive for every subsequent ssh/rsync). $SHUTTLE_HANDSHAKE_REPLY is what gets
# typed at the prompt. Only worth firing when the human is reachable — hence
# opt-in via --handshake, never part of an unattended run.
try_handshake() { # $1 = host; returns 0 with a live master, 1 otherwise
  local host="$1" dest flags sess="shuttle-handshake-$1"
  [ "$(fleet_auth "$host")" = "interactive" ] || return 1
  [ "$HANDSHAKE" = 1 ] || { bad "no live ControlMaster; rerun with --handshake (a human must approve the prompt)"; return 1; }
  dest="$(fleet_ssh "$host")"
  flags="$(fleet_flags "$host")"
  tmux kill-session -t "$sess" 2>/dev/null
  tmux new-session -d -s "$sess" "ssh $flags $dest" || { bad "could not open tmux for handshake"; return 1; }
  sleep 5
  tmux send-keys -t "$sess" "${SHUTTLE_HANDSHAKE_REPLY:-1}" Enter
  printf '  %s…%s auth prompt answered — approve the push if one was sent (times out in ~60s)\n' "$BOLD" "$RESET"
  for _ in $(seq 1 25); do
    ssh $flags -O check "$dest" 2>/dev/null && { ok "ControlMaster live"; tmux kill-session -t "$sess" 2>/dev/null; return 0; }
    sleep 3
  done
  bad "handshake timed out (prompt not approved?)"
  tmux kill-session -t "$sess" 2>/dev/null
  return 1
}

# SSH joins its command arguments into shell text. Quote both the checkout
# path inside the build command and that command inside the remote bash call.
shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

BOLD=$'\033[1m'; GREEN=$'\033[32m'; RED=$'\033[31m'; RESET=$'\033[0m'
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
bad()  { printf '  %s✗%s %s: %s\n' "$RED" "$RESET" "${HOST:-deploy}" "$1" >&2; }
say()  { printf '\n%s▸ %s%s\n' "$BOLD" "$1" "$RESET"; }

REPO="$(cd "$(dirname "$0")/.." && pwd)"
HOSTS="$FLEET_ORDER"
PUSH=1
HANDSHAKE=0
DEPLOY_REF=""

while [ $# -gt 0 ]; do
  case "$1" in
    --hosts) HOSTS="$(echo "$2" | tr ',' ' ')"; shift 2 ;;
    --hosts=*) HOSTS="$(echo "${1#*=}" | tr ',' ' ')"; shift ;;
    --no-push) PUSH=0; shift ;;
    --ref) [ $# -ge 2 ] && [ -n "$2" ] || { echo "--ref needs a revision" >&2; exit 2; }; DEPLOY_REF="$2"; shift 2 ;;
    --ref=*) DEPLOY_REF="${1#*=}"; [ -n "$DEPLOY_REF" ] || { echo "--ref needs a revision" >&2; exit 2; }; shift ;;
    --handshake) HANDSHAKE=1; shift ;;
    --list)
      for h in $FLEET_ORDER; do
        ui=build; builds_ui "$h" || ui=shipped
        printf '%-16s %-16s %-8s %s\n' "$h" "$(fleet_ssh "$h")" "$ui" "$(fleet_dir "$h")"
      done
      [ -f "$FLEET_FILE" ] || printf 'no fleet file at %s — local only\n' "$FLEET_FILE"
      exit 0 ;;
    -h|--help) sed -n '2,43p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

for h in $HOSTS; do
  [ -n "$(fleet_dir "$h")" ] || {
    echo "unknown host: $h (see --list; a remote needs a \"checkout\" in $FLEET_FILE)" >&2
    exit 2
  }
done

TARGET_COMMIT="$(git -C "$REPO" rev-parse --verify "${DEPLOY_REF:-HEAD}^{commit}")" || exit 1
TARGET_SHA="${TARGET_COMMIT:0:7}"
DEPLOY_VERSION=""
if [ -n "$DEPLOY_REF" ] && [[ "$DEPLOY_REF" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)$ ]]; then
  DEPLOY_VERSION="${BASH_REMATCH[1]}"
fi

if [ "$PUSH" = 1 ]; then
  say "push (target $TARGET_SHA)"
  if [ -n "$DEPLOY_REF" ]; then
    PUSH_REF="$(git -C "$REPO" rev-parse --symbolic-full-name "$DEPLOY_REF")" || exit 1
    if [ -n "$PUSH_REF" ]; then
      git -C "$REPO" push origin "$PUSH_REF" && ok "pushed" || { bad "git push failed"; exit 1; }
    else
      ok "target $TARGET_SHA is a commit, not a ref to push"
    fi
  else
    git -C "$REPO" push && ok "pushed" || { bad "git push failed"; exit 1; }
  fi
fi

# A red target gets one bounded warning; CI never gates a deployment.
warn_target_ci() {
  "$REPO/scripts/ci-status-hook.sh" "$TARGET_COMMIT" || true
}

warn_target_ci

preflight_remote_revision() {
  local host upstream advertised oid ref available
  for host in $HOSTS; do
    [ "$host" != local ] || continue
    git -C "$REPO" fetch -q origin || { bad 'preflight: origin fetch failed'; return 1; }
    advertised="$(git -C "$REPO" ls-remote origin)" || { bad 'preflight: cannot inspect origin'; return 1; }
    available=0
    while read -r oid ref; do
      [ -n "$oid" ] || continue
      git -C "$REPO" cat-file -e "$oid" 2>/dev/null || git -C "$REPO" fetch -q origin "$oid" || continue
      if git -C "$REPO" merge-base --is-ancestor "$TARGET_COMMIT" "$oid" 2>/dev/null; then available=1; break; fi
    done <<EOF
$advertised
EOF
    [ "$available" = 1 ] || { bad "preflight: origin does not provide target $TARGET_COMMIT"; return 1; }
    if [ -z "$DEPLOY_REF" ]; then
      upstream="$(git -C "$REPO" rev-parse --verify '@{u}^{commit}')" \
        || { bad 'preflight: no upstream; use --ref for an explicit revision'; return 1; }
      git -C "$REPO" merge-base --is-ancestor "$upstream" "$TARGET_COMMIT" \
        || { bad 'preflight: target is not a descendant of upstream; use --ref for an explicit rollback'; return 1; }
    fi
    return 0
  done
}

preflight_remote_revision || exit 1

# Every host fetches this object, never a moving branch. Harness packages use
# the same exact-ref path even when the caller omitted --ref.
DEPLOY_REF="${DEPLOY_REF:-HEAD}"

# Exact-ref worktrees are immutable runtime roots. Build in a new path, seed
# only disposable caches by copying, and prune old roots only after verification.
deploy_root_cmd() {
  local checkout="$1"
  cat <<SH
set -eu
source=$(shell_quote "$checkout")
common=\$(git -C "\$source" rev-parse --git-common-dir)
case "\$common" in /*) ;; *) common="\$source/\$common" ;; esac
common=\$(cd "\$common" && pwd -P)
main=\$(dirname "\$common")
printf '%s.deploy\\n' "\$main"
SH
}

seed_deploy_cache_cmd() {
  local source="$1" fallback="${2:-}" # The emitted snippet uses the caller's target.
  cat <<SH
(
  set +e
  source=$(shell_quote "$source")
  if [ ! -d "\$source" ] || [ "\$source" -ef "\$target" ]; then source=$(shell_quote "$fallback"); fi
  [ -d "\$source" ] || exit 0
  for relative in daemon/deps daemon/_build ui/node_modules; do
    if [ -L "\$source/\$relative" ] || [ -L "\$target/\$relative" ]; then
      printf 'cache seeding skipped: symlinked cache root %s\\n' "\$relative" >&2
      exit 0
    fi
  done
  stage="\$target/.deploy-cache-seed.\$\$"
  if ! mkdir -p "\$stage"; then
    printf 'cache seeding failed; building cold\\n' >&2
    exit 1
  fi
  failed=0
  for relative in daemon/deps daemon/_build ui/node_modules; do
    [ -d "\$source/\$relative" ] || continue
    mkdir -p "\$stage/\$relative" || { failed=1; break; }
    case \$(uname -s) in
      Darwin)
        cp -cR -P "\$source/\$relative/." "\$stage/\$relative/" 2>/dev/null ||
          cp -R -P "\$source/\$relative/." "\$stage/\$relative/" 2>/dev/null || failed=1 ;;
      *)
        cp -R -P --reflink=auto "\$source/\$relative/." "\$stage/\$relative/" 2>/dev/null ||
          cp -R -P "\$source/\$relative/." "\$stage/\$relative/" 2>/dev/null || failed=1 ;;
    esac
    [ "\$failed" = 0 ] || break
  done
  if [ -d "\$stage/ui/node_modules" ]; then
    if [ -f "\$source/ui/node_modules/.npm-ci-stamp" ] &&
       cmp -s "\$source/ui/package-lock.json" "\$target/ui/package-lock.json"; then
      touch "\$stage/ui/node_modules/.npm-ci-stamp" || failed=1
    else
      rm -f "\$stage/ui/node_modules/.npm-ci-stamp" || failed=1
    fi
  fi
  for relative in daemon/deps daemon/_build ui/node_modules; do
    if [ -d "\$stage/\$relative" ] && [ -e "\$target/\$relative" ]; then failed=1; fi
  done
  published=
  if [ "\$failed" = 0 ]; then
    for relative in daemon/deps daemon/_build ui/node_modules; do
      [ -d "\$stage/\$relative" ] || continue
      if ! mv "\$stage/\$relative" "\$target/\$relative"; then failed=1; break; fi
      published="\$published \$relative"
    done
  fi
  if [ "\$failed" != 0 ]; then
    for relative in \$published; do rm -rf "\$target/\$relative" 2>/dev/null || true; done
    rm -rf "\$stage" 2>/dev/null || true
    printf 'cache seeding failed; building cold\\n' >&2
    exit 1
  fi
  rm -rf "\$stage" 2>/dev/null || true
  printf 'seeded build caches from %s\\n' "\$source"
) || { printf 'cache seeding failed; building cold\\n' >&2; }
SH
}

revision_checkout_cmd() {
  local checkout="$1" previous="${2:-}"
  cat <<SH
set -eu
source=$(shell_quote "$checkout")
commit=$(shell_quote "$TARGET_COMMIT")
root=\$(bash -c $(shell_quote "$(deploy_root_cmd "$checkout")"))
target="\$root/\$commit"
git -C "\$source" cat-file -e "\$commit^{commit}" 2>/dev/null || git -C "\$source" fetch origin "\$commit"
valid_target() {
  [ -f "\$target/.git" ] &&
    [ "\$(git -C "\$target" rev-parse HEAD 2>/dev/null)" = "\$commit" ] &&
    edits=\$(git -C "\$target" status --porcelain --untracked-files=no 2>/dev/null) && [ -z "\$edits" ]
}
if ! valid_target; then
  git -C "\$source" worktree unlock "\$target" 2>/dev/null || true
  git -C "\$source" worktree remove --force "\$target" 2>/dev/null || rm -rf "\$target"
  git -C "\$source" worktree prune
  mkdir -p "\$root"
  git -C "\$source" worktree add --detach "\$target" "\$commit"
  $(seed_deploy_cache_cmd "$previous" "$checkout")
fi
valid_target
SH
}

prune_deploy_cmd() {
  local checkout="$1" previous="${2:-}" cli="${3:-$1/shuttle}"
  cat <<SH
set -eu
source=$(shell_quote "$checkout")
root=\$(bash -c $(shell_quote "$(deploy_root_cmd "$checkout")"))
$(shell_quote "$cli") daemon prune-releases "\$source" "\$root" --keep "\$root/$TARGET_COMMIT" --keep $(shell_quote "$previous")
SH
}

build_checkout_cmd() {
  local checkout="$1" skip_ui="${2:-0}"
  printf 'cd %s && ' "$(shell_quote "$checkout")"
  if [ -n "$DEPLOY_VERSION" ]; then
    printf 'export SHUTTLE_VERSION=%s GOFLAGS=%s && ' "$(shell_quote "$DEPLOY_VERSION")" \
      "$(shell_quote "'-ldflags=-X=main.version=$DEPLOY_VERSION -X=main.commit=$TARGET_COMMIT'")"
  fi
  printf 'make build'
  [ "$skip_ui" = 1 ] && printf ' SKIP_UI=1'
  printf ' && make cli-install'
  return 0
}

# Shell snippets reach the daemon at the address `shuttle host --json`
# resolves: its unix socket on a shared or exposed host, loopback TCP
# otherwise. Both `felt` and `shuttle` must be on PATH; an error from the host
# command stops the snippet rather than silently choosing another listener.
# The prelude sets `sock`, `port`, `base`, and the daemon data directory `dd`.
listen_prelude() {
  printf '%s' 'l=; dd=; command -v felt >/dev/null 2>&1 || { echo "felt is not on PATH" >&2; exit 3; }; '
  printf '%s' 'command -v shuttle >/dev/null 2>&1 || { echo "shuttle is not on PATH" >&2; exit 3; }; '
  printf '%s' 'out=$(shuttle host --json 2>&1) || { echo "cannot resolve the daemon listen address: $out" >&2; exit 3; }; '
  printf '%s' 'dd=$(printf "%s\n" "$out" | sed -n '"'"'s/.*"data_dir": *"\([^"]*\)".*/\1/p'"'"' | head -n 1); '
  printf '%s' 'l=$(printf "%s\n" "$out" | sed -n '"'"'s/.*"listen": *"\([^"]*\)".*/\1/p'"'"' | head -n 1); '
  printf '%s' 'sock=; port=4000; '
  printf '%s' 'case "$l" in unix://*) sock="${l#unix://}";; tcp://127.0.0.1:*) port="${l##*:}";; esac; '
  printf '%s' 'base=http://127.0.0.1:$port; [ -n "$sock" ] && base=http://localhost; '
}

daemon_call() { # $1 = extra curl args, $2 = API path
  listen_prelude
  printf '%s' 'shuttle host check-owner && '
  printf '%s' "curl -s --max-time 10 $1"' ${sock:+--unix-socket "$sock"} "$base'"$2"'"'
}

daemon_listener_cmd() {
  printf '%s' 'if [ -n "$sock" ]; then lsof -t -- "$sock"; else lsof -ti:"$port" -sTCP:LISTEN; fi'
}

disable_competing_supervisors_cmd() {
  cat <<'SH'
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1 &&
   { systemctl --user is-enabled --quiet shuttle-daemon.service 2>/dev/null || systemctl --user is-active --quiet shuttle-daemon.service 2>/dev/null; }; then
  systemctl --user disable --now shuttle-daemon.service || exit 1
fi
if command -v launchctl >/dev/null 2>&1 && launchctl print "gui/$(id -u)/io.shuttle.daemon" >/dev/null 2>&1; then
  launchctl bootout "gui/$(id -u)/io.shuttle.daemon" || exit 1
fi
SH
}

# Kill the daemon's listener; the host's supervisor restarts it.
# The snippet runs on the target host, and touches the daemon's stop
# marker there before the SIGTERM, so the rebuilt daemon's boot quarantine holds
# (Shuttle.DaemonHeartbeat). The marker lives in the data directory that host's
# `shuttle host --json` reports, else the plain $SHUTTLE_DATA_DIR expansion.
daemon_kill() {
  listen_prelude
  printf '%s' 'touch "${dd:-${SHUTTLE_DATA_DIR:-$HOME/.shuttle}}/heartbeat.stopped" 2>/dev/null; '
  printf 'pids=$(%s || true); ' "$(daemon_listener_cmd)"
  # When switching away from a competing service, signal only the listener
  # observed before that service stopped, never its replacement from the loop.
  printf '%s' 'for pid in $pids; do for original in ${cycle_listener_pids-$pids}; do if [ "$pid" = "$original" ]; then kill "$pid"; break; fi; done; done'
}

run_local() { # Target-side children do not retain transaction descriptors.
  bash -c "$1" 3>&- 4>&- 5>&- </dev/null
}

run_value() { # Profile stdout is not command output; require both frame ends.
  local marker="SHUTTLE_DEPLOY_VALUE_$$" out status
  local command="printf '\\n%s BEGIN\\n' '$marker'
bash -c $(shell_quote "$2")
status=\$?
printf '\\n%s END %s\\n' '$marker' \"\$status\"
exit \"\$status\""
  out=$(ssh -n $(fleet_flags "$1") "$(fleet_ssh "$1")" "bash -lc $(shell_quote "$command") </dev/null")
  status=$?
  [ "$status" = 0 ] || return "$status"
  case "$out" in
    *"$marker BEGIN"$'\n'*"$marker END 0") ;;
    *) printf 'deploy: missing value completion frame on %s\n' "${1:-local}" >&2; return 1;;
  esac
  out="${out#*"$marker BEGIN"$'\n'}"
  printf '%s' "${out%$'\n'"$marker END 0"}"
}

version_json() {
  run_local "$(daemon_call "" /api/v1/version)"
}

previous_deploy() { # Capture the live commit before retargeting the host's launcher.
  local checkout="$1" sha
  sha="$(version_json | sed -n 's/.*"git_short_sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  [ -n "$sha" ] || return 0
  run_local "root=\$(bash -c $(shell_quote "$(deploy_root_cmd "$checkout")")); commit=\$(git -C $(shell_quote "$checkout") rev-parse --verify $(shell_quote "$sha^{commit}")) && printf '%s/%s\\n' \"\$root\" \"\$commit\""
}

version_ready() { # JSON response -> true only for an explicit ready:true
  printf '%s\n' "$1" | grep -Eq '"ready"[[:space:]]*:[[:space:]]*true([,}])'
}

version_launch_health() { # JSON response -> empty only when launch holds are clear
  printf '%s' "$1" | python3 -c '
import json,sys
try:
    v=json.load(sys.stdin)
    contract=v.get("contract") or {}
    if contract.get("ok") is not True:
        print("contract: " + str(contract.get("reason") or "Poller receipt unavailable"))
    elif "reconciliation_hold" not in v:
        print("Poller reconciliation receipt unavailable")
    elif v["reconciliation_hold"] is not None:
        print("migration recovery: " + json.dumps(v["reconciliation_hold"]))
except (ValueError, TypeError, AttributeError):
    print("Poller receipt unavailable")
'
}

release_quarantine() {
  [ -n "${VERIFIED_RELEASE_RECEIPT:-}" ] || { echo 'missing verified daemon identity' >&2; return 1; }
  local body="{\"expected\":$VERIFIED_RELEASE_RECEIPT}"
  run_local "$(daemon_call "-f -X POST -H 'Content-Type: application/json' --data $(shell_quote "$body")" /api/v1/quarantine/release)" | grep -q '"ok":true'
}

wait_for_sha() { # Poll for a fresh, ready boot at the selected release path.
  local host="${HOST:-local}" expected="${1:-${EXPECTED_RELEASE:-}}" version="" sha="" booted="" ready="" mix_vsn="" release_path="" started="" now="" elapsed="" next_notice=""
  [ -n "$expected" ] || { echo "deploy verification requires an expected release_path" >&2; return 1; }
  local health=""
  VERIFIED_RELEASE_RECEIPT=""
  local timeout="${SHUTTLE_DEPLOY_READY_TIMEOUT_SECONDS:-900}"
  local interval="${SHUTTLE_DEPLOY_READY_POLL_INTERVAL_SECONDS:-5}"

  case "$timeout" in ''|*[!0-9]*) timeout=900 ;; esac
  case "$interval" in ''|*[!0-9]*|0) interval=5 ;; esac
  started="$(date +%s)"
  next_notice=0

  while :; do
    version="$(version_json 2>/dev/null || true)"
    sha="$(printf '%s\n' "$version" | sed -n 's/.*"git_short_sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    booted="$(printf '%s\n' "$version" | sed -n 's/.*"booted_at"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    mix_vsn="$(printf '%s\n' "$version" | sed -n 's/.*"mix_vsn"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    release_path="$(printf '%s\n' "$version" | sed -n 's/.*"release_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    if version_ready "$version"; then ready=true; else ready=false; fi
    if [ "$ready" = true ] && [ -n "$booted" ] && [ "$booted" \> "$DEPLOY_STARTED_AT" ] && [ "$release_path" != "$expected" ]; then
      printf '  deployment lost its release selection on %s: expected release_path=%s, running release_path=%s\n' "${host:-local}" "$expected" "${release_path:-missing}" >&2
      return 1
    fi

    health="$(version_launch_health "$version")" || return 1
    # Initialization and launch health are independent: boot quarantine is
    # releasable, but contract skew and migration recovery must clear first.
    if [ "$sha" = "$TARGET_SHA" ] && [ "$release_path" = "$expected" ] && [ "$ready" = true ] && [ -z "$health" ] &&
       { [ -z "${DEPLOY_VERSION:-}" ] || [ "$mix_vsn" = "$DEPLOY_VERSION" ]; } &&
       [ -n "$booted" ] && [ "$booted" \> "$DEPLOY_STARTED_AT" ]; then
      VERIFIED_RELEASE_RECEIPT="$(printf '%s' "$version" | python3 -c 'import json,sys; v=json.load(sys.stdin); isinstance(v.get("incarnation"),str) and v["incarnation"] or sys.exit("automated rollback requires incarnation-bound release support (e8fc948a or a descendant); quarantine remains held"); print(json.dumps({k:v[k] for k in ("incarnation","release_path")}))')" || return 1
      return 0
    fi

    now="$(date +%s)"
    elapsed=$((now - started))
    if [ "$elapsed" -ge "$timeout" ]; then
      if [ -z "$version" ]; then
        printf '  daemon on %s did not answer /api/v1/version within %ss\n' "${host:-local}" "$timeout" >&2
      elif [ "$ready" != true ]; then
        printf '  daemon on %s is still booting after %ss; /api/v1/version must report ready:true\n' "${host:-local}" "$elapsed" >&2
      elif [ -n "$health" ]; then
        printf '  daemon on %s holds launches: %s\n' "${host:-local}" "$health" >&2
      elif [ -n "${DEPLOY_VERSION:-}" ] && [ "$mix_vsn" != "$DEPLOY_VERSION" ]; then
        printf '  daemon on %s reports version %s; expected %s\n' "${host:-local}" "${mix_vsn:-missing}" "$DEPLOY_VERSION" >&2
      else
        printf '  daemon on %s did not prove a fresh ready boot on %s within %ss\n' "${host:-local}" "$TARGET_SHA" "$timeout" >&2
      fi
      return 1
    fi

    if [ "$elapsed" -ge "$next_notice" ]; then
      if [ -z "$version" ]; then
        printf '  waiting for daemon on %s to answer /api/v1/version (%ss elapsed)\n' "${host:-local}" "$elapsed" >&2
      elif [ "$ready" != true ]; then
        printf '  daemon on %s is still booting; waiting for ready:true (%ss elapsed)\n' "${host:-local}" "$elapsed" >&2
      elif [ -n "$health" ]; then
        printf '  daemon on %s holds launches: %s (%ss elapsed)\n' "${host:-local}" "$health" "$elapsed" >&2
      else
        printf '  daemon on %s answers but its fresh boot on %s is not verified (%ss elapsed)\n' "${host:-local}" "$TARGET_SHA" "$elapsed" >&2
      fi
      next_notice=$((elapsed + 30))
    fi
    sleep "$interval"
  done
}

remember_previous_cmd() {
  cat <<SH
set -eu
previous=$(shell_quote "$1")
current=$(shell_quote "$2")
state="\$HOME/.shuttle/deploy/previous"
mkdir -p "\$(dirname "\$state")"
if [ -n "\$previous" ] && [ "\$previous" != "\$current" ]; then
  printf '%s\\n' "\$previous" > "\$state.next"
  mv "\$state.next" "\$state"
fi
[ ! -f "\$state" ] || cat "\$state"
SH
}

refresh_checkout_cmd() {
  cat <<SH
source=$(shell_quote "$1")
commit=$(shell_quote "$TARGET_COMMIT")
if git -C "\$source" symbolic-ref -q HEAD >/dev/null &&
   git -C "\$source" diff --quiet && git -C "\$source" diff --cached --quiet &&
   git -C "\$source" merge-base --is-ancestor HEAD "\$commit" &&
   git -C "\$source" merge --ff-only --no-edit "\$commit"; then
  printf 'checkout freshness: %s is at %s\\n' "\$source" "\$commit"
else
  printf 'checkout freshness: left %s unchanged; not a clean branch fast-forward to %s\\n' "\$source" "\$commit"
fi
SH
}

release_verified_deploy() {
  release_quarantine || { bad "quarantine release failed"; return 1; }
  run_local "$(remember_previous_cmd "${1:-}" "${EXPECTED_RELEASE%/bin/*}")" >/dev/null \
    || { bad 'rollback receipt: could not retain previous release'; return 1; }
  ok "live on $TARGET_SHA, quarantine released"
}

finish_verified_deploy() { # Regular checkout; rollback provenance is already retained.
  local checkout="$1" previous
  previous="$(run_local 'if [ -f "$HOME/.shuttle/deploy/previous" ]; then cat "$HOME/.shuttle/deploy/previous"; fi')" \
    || { bad 'rollback receipt: could not read previous release'; return 1; }
  run_local "$(refresh_checkout_cmd "$checkout")" || ok "checkout freshness: could not inspect $checkout; left unchanged"
  refresh_harnesses "${EXPECTED_RELEASE%/bin/*}" || { bad "harness setup failed"; return 1; }
  run_local "$(prune_deploy_cmd "$checkout" "$previous" "${EXPECTED_RELEASE%/bin/*}/shuttle")" || {
    bad "could not prune deploy worktrees on ${HOST:-local}"
    return 1
  }
}

verify_and_release() {
  wait_for_sha || return 1
  release_verified_deploy "${1:-}"
}

activation_window() { # Prepared activation command, previous release root.
  local command="$1" previous="$2" status=0 ack
  printf B >&5 && IFS= read -r ack <&5 || return 1
  if [ "${3:-}" = coalesced ]; then
    run_local "$command" && release_verified_deploy "$previous" || status=$?
  else
    run_local "$command" && verify_and_release "$previous" || status=$?
  fi
  printf E >&5 && IFS= read -r ack <&5 || return 1
  return "$status"
}

# A shipped-UI host receives a snapshot of the pinned local tree's bundle.
# Once copied under the local lease, the snapshot is independent of pruning.
LOCAL_UI_BUILT=0
ensure_local_ui() {
  [ "$LOCAL_UI_BUILT" = 1 ] && return 0
  run_transaction "" "$REPO" ui "" "" "$UI_SNAPSHOT" \
    || { bad "make ui failed on the deploy host; it has no bundle to ship"; return 1; }
  LOCAL_UI_BUILT=1
}

# Ship ui/dist into a non-building host's checkout. --delete because ui/dist is
# wholly generated: a file left from an older bundle is never referenced by the
# new index.html and only accumulates.
ship_ui() { # SSH destination, checkout directory, SSH flags.
  ensure_local_ui || return 1
  ssh $3 "$1" "mkdir -p $(shell_quote "$2/ui")" \
    || { bad "could not prepare $2/ui"; return 1; }
  rsync -az --delete -e "ssh $3" "$UI_SNAPSHOT/" "$1:$2/ui/dist/" \
    || { bad "could not ship the UI bundle"; return 1; }
  ok "shipped ui/dist (this host does not build it)"
}

# Bring felt's harness plugins up to the checkout just built. A harness counts
# as installed when felt's plugin is enabled in it: Claude Code and Codex as
# the enabled bundles of `felt setup receipt --json`, pi as a felt package in
# `pi list` (the GitHub package, or a local directory whose package.json names
# felt). A harness binary on PATH alone does not count, since setting up a
# plugin the operator never installed, or removed, is worse than skipping it.
# Each bundle's `inspection` says how its enablement was established:
# "confirmed" by the harness's plugin list, "configured" by its config and
# cache alone, or "unknown" when the list failed or the config could not be
# read. An unknown bundle fails the host with the receipt's repair instead of
# being set up, as does a receipt that cannot be read at all.
# Claude Code and Codex are set up from the checkout itself (`--source`), so
# the sealed generation carries the tree the felt binary was built from and
# setup needs no network. They are skipped when the receipt passes and its
# active generation was sealed at the checkout's HEAD by a clean build; a dirty
# build ("dev (<sha>-dirty)") names no fixed tree, so it is always set up
# again. pi has no --source and no generation. Its GitHub package follows the
# default branch, so `felt setup pi` runs only when that clone is not at HEAD.
# A local felt package is never re-pointed. Exact-ref deploys pin a clean
# GitHub clone to the deployed commit; ordinary deploys follow felt setup pi.
# The snippet runs in the host's login shell, the PATH its harnesses' hooks
# resolve felt through, and ends with one `harness-ok` or `harness-fail` line.
harness_setup_cmd() { # $1 = checkout dir
  printf 'dir=%s\n' "$(shell_quote "$1")"
  printf 'exact_ref=%s\n' "$(shell_quote "${DEPLOY_REF:-}")"
  cat <<'SH'
report() { printf 'harness-%s %s\n' "$1" "$2"; }
fail() { report fail "$1"; exit 1; }
tail_of() { printf '%s\n' "$1" | tail -n 2 | tr '\n' ' '; }
# problems names each receipt component that is not healthy (felt, a bundle,
# hooks, generation) with its own repair, a repair shared by several only
# once, and falls back to the receipt's top-level repair. Components sit two
# spaces in, their fields four (a bundle's six); a generation's per-harness
# copies are deeper and already folded into its own repair.
problems() (
  felt setup receipt --json 2>/dev/null | awk '
    function val(line) { sub(/^[^:]*: *"?/, "", line); sub(/"?,?$/, "", line); gsub(/\\"/, "\"", line); return line }
    function add(what, why) {
      if (why != "" && !(why in seen)) { seen[why] = 1; what = what ": " why }
      out = out (out == "" ? "" : "; ") what
    }
    /^  "repair":/ { top = val($0); next }
    /^  "[a-z_]+": [[{]$/ { sect = $0; sub(/^  "/, "", sect); sub(/".*/, "", sect); st = ""; rp = ""; next }
    /^  []}],?$/ { if (sect != "bundles" && st != "" && st != "healthy") add(sect " " st, rp); sect = ""; next }
    sect == "bundles" && /^      "harness":/ { h = val($0) }
    sect == "bundles" && /^      "status":/ { st = val($0) }
    sect == "bundles" && /^      "repair":/ { rp = val($0) }
    sect == "bundles" && /^    },?$/ { if (st != "healthy") add(h " plugin " st, rp); st = ""; rp = "" }
    sect != "bundles" && /^    "status":/ { st = val($0) }
    sect != "bundles" && /^    "repair":/ { rp = val($0) }
    END { print (out != "" ? out : top) }'
)
tab=$(printf '\t')
command -v felt >/dev/null 2>&1 || fail "felt is not on PATH"
head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || fail "cannot read HEAD in $dir"
summary=

receipt=$(felt setup receipt --json 2>/dev/null)
healthy=$?
# felt prints the receipt in one write, so a complete one closes its bundles
# (null, empty, or a list whose closing bracket arrived) and ends with the
# top-level object's unindented closing brace. Anything less is unreadable,
# and an unreadable receipt cannot say which harnesses carry felt.
complete=$(printf '%s\n' "$receipt" | awk '
  /^  "bundles": (null|\[\]),?$/ { bundles = 2 }
  /^  "bundles": \[$/ { bundles = 1; next }
  bundles == 1 && /^  \],?$/ { bundles = 2 }
  NF { last = $0 }
  END { print (bundles == 2 && last == "}") ? "yes" : "no" }')
[ "$complete" = yes ] ||
  fail "felt setup receipt --json gave no complete receipt (exit $healthy): $(tail_of "$(felt setup receipt --json 2>&1 >/dev/null)")"
# The receipt is indented JSON, one key per line. Only its bundles carry
# "enabled"; each opens with its harness and holds no nested object.
bundles=$(printf '%s\n' "$receipt" | awk '
  function val(line) { sub(/^[^:]*: *"?/, "", line); sub(/"?,?$/, "", line); gsub(/\\"/, "\"", line); return line }
  /"harness":/ { h = val($0); on = 0; how = ""; rep = ""; next }
  /"inspection":/ { how = val($0) }
  /"repair":/ { rep = val($0) }
  /"enabled": true/ { on = 1 }
  on && /^ *\},?$/ { print h "\t" how "\t" rep; on = 0 }')
harnesses=
while IFS="$tab" read -r h how reason; do
  [ -n "$h" ] || continue
  case "$how" in
    confirmed|configured) harnesses="$harnesses$h " ;;
    unknown) fail "cannot tell whether $h carries felt's plugin: ${reason:-its plugin list could not be read}" ;;
    *) fail "the receipt gives $h no known inspection (${how:-none}); the felt on PATH may predate this checkout" ;;
  esac
done <<EOF
$bundles
EOF
sealed=$(printf '%s\n' "$receipt" | awk '
  /"active": \{/ { inside = 1; next }
  inside && /"resolved_commit":/ { c = $0; sub(/.*"resolved_commit": *"/, "", c); sub(/".*/, "", c); print c; exit }
  inside && /\}/ { exit }')
case "$(felt --version 2>/dev/null)" in *-dirty*) dirty=1 ;; *) dirty=0 ;; esac
if [ -n "$harnesses" ]; then
  if [ "$healthy" = 0 ] && [ "$sealed" = "$head" ] && [ "$dirty" = 0 ]; then
    summary="${harnesses}current"
  else
    for h in $harnesses; do
      felt setup "$h" --source "$dir" || fail "felt setup $h failed"
    done
    if ! felt setup receipt >/dev/null 2>&1; then
      repair=$(problems)
      fail "setup receipt still fails after felt setup: ${repair:-run felt setup receipt}"
    fi
    summary="${harnesses}set up"
  fi
fi

# `pi list` prints each package's source, then its resolved path indented
# below it; a source without a scheme is a local directory.
if command -v pi >/dev/null 2>&1; then
  listed=$(pi list 2>&1) || fail "pi list failed: $(tail_of "$listed")"
  packages=$(printf '%s\n' "$listed" | awk '
    /^  [^ ]/ { src = $0; sub(/^ +/, "", src); next }
    /^    [^ ]/ {
      p = $0; sub(/^ +/, "", p)
      if (index(src, "git:github.com/cailmdaley/felt") == 1) print "git\t" p
      else if (src !~ /:/) print "local\t" p
    }')
  checkout=$(cd "$dir" && pwd -P)
  # A package other than the deployed checkout must also match HEAD in its
  # files: tracked edits or deletions change what pi loads. Untracked files
  # are ignored, since pi's own npm install leaves a package-lock.json there.
  # edits sets `changed` to the first edited paths, and fails the host when git
  # cannot inspect the package at all.
  edits() {
    local out
    out=$(git -C "$1" status --porcelain --untracked-files=no 2>&1) ||
      fail "cannot inspect pi's felt package $1: $(tail_of "$out")"
    changed=$(printf '%s\n' "$out" | sed '/^$/d' | head -n 3 | tr '\n' ' ')
  }
  # A local package is felt when its committed package.json names felt, so an
  # edited or deleted working copy cannot hide it; a package outside git falls
  # back to its working package.json.
  manifest_name() {
    if git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then
      git -C "$1" show HEAD:package.json 2>/dev/null
    else
      cat "$1/package.json" 2>/dev/null
    fi |
      sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
  }
  while IFS="$tab" read -r kind path; do
    [ -n "$path" ] || continue
    if [ "$kind" = local ]; then
      [ "$(manifest_name "$path")" = felt ] || continue
      at=$(git -C "$path" rev-parse HEAD 2>/dev/null)
      if [ "$(cd "$path" 2>/dev/null && pwd -P)" = "$checkout" ]; then
        summary="${summary:+$summary, }pi current"
      elif [ "$at" = "$head" ]; then
        edits "$path"
        [ -z "$changed" ] || fail "pi loads felt from the local package $path, at the deployed ${head:0:7} but with local edits ($changed); commit or discard them there (git -C $path status)"
        summary="${summary:+$summary, }pi current"
      else
        where="no git commit"; [ -z "$at" ] || where="commit ${at:0:7}"
        fail "pi loads felt from the local package $path at $where, not the deployed ${head:0:7}; update that checkout, or point pi at this one with pi install $dir"
      fi
      continue
    fi
    at=$(git -C "$path" rev-parse HEAD 2>/dev/null)
    if [ "$at" = "$head" ]; then
      state="pi current"
    elif [ -n "$exact_ref" ]; then
      edits "$path"
      [ -z "$changed" ] || fail "pi's felt package $path is at ${at:0:7}, not the deployed ${head:0:7}; pin its installed source to $exact_ref or install the deployed source with pi install $dir"
      out=$(git -C "$path" fetch origin "$head" 2>&1) &&
        out=$(git -C "$path" checkout --detach "$head" 2>&1) ||
        fail "pi's felt package $path is at ${at:0:7}, not the deployed ${head:0:7}; pin its installed source to $exact_ref or install the deployed source with pi install $dir"
      at=$(git -C "$path" rev-parse HEAD 2>/dev/null)
      [ "$at" = "$head" ] || fail "pi's felt package $path is at ${at:0:7}, not the deployed ${head:0:7}; pin its installed source to $exact_ref or install the deployed source with pi install $dir"
      state="pi pinned"
    else
      out=$(felt setup pi 2>&1) || fail "felt setup pi failed: $(tail_of "$out")"
      at=$(git -C "$path" rev-parse HEAD 2>/dev/null)
      [ "$at" = "$head" ] || fail "pi's felt package is at ${at:0:7}, not ${head:0:7}; felt setup pi installs GitHub's default branch"
      state="pi set up"
    fi
    edits "$path"
    [ -z "$changed" ] || fail "pi's felt clone $path is at the deployed ${head:0:7} but has local edits ($changed); discard them with git -C $path checkout -- . and redeploy"
    summary="${summary:+$summary, }$state"
  done <<EOF
$packages
EOF
fi

report ok "harness plugins: ${summary:-none carry felt}"
SH
}

refresh_harnesses() { # Pinned checkout to install from.
  local out line
  out=$(run_local "$(harness_setup_cmd "$1")" 2>&1)
  line=$(printf '%s\n' "$out" | sed -n 's/^harness-ok //p' | tail -n 1)
  [ -n "$line" ] && { ok "$line"; return 0; }
  line=$(printf '%s\n' "$out" | sed -n 's/^harness-fail //p' | tail -n 1)
  printf '%s\n' "$out" >&2
  bad "${line:-harness setup did not report: $(printf '%s' "$out" | tail -n 2)}"
  return 1
}

deploy_local() {
  say "local ($TARGET_SHA)"
  run_transaction "" "$REPO" deploy "" "" "$UI_SNAPSHOT" || return 1
  LOCAL_UI_BUILT=1
}

remote_host_cycle() { # Deployed checkout, previous release root; runs on its owner.
  local checkout="$1" previous="$2" supervisor=""
  supervisor="$(run_local "$(supervisor_probe_cmd)")" || { bad "could not inspect the host's supervisor"; return 1; }
  EXPECTED_RELEASE="$(built_release "$checkout")" || return 1
  local cycle
  if [ "$supervisor" = tmux ]; then
    # Keep the live loop; only its listener needs a graceful cycle. Recreating
    # the loop as well can kill the replacement it has just started.
    cycle="set -eu
install -m 755 $(shell_quote "$checkout/bin/shuttle-launch") \"\$HOME/.local/bin/shuttle-launch\"
$(listen_prelude)
cycle_listener_pids=\$($(daemon_listener_cmd) || true)
touch \"\${dd:-\${SHUTTLE_DATA_DIR:-\$HOME/.shuttle}}/heartbeat.stopped\"
$(disable_competing_supervisors_cmd)
$(daemon_kill)"
  else
    cycle="set -eu; $(listen_prelude)
touch \"\${dd:-\${SHUTTLE_DATA_DIR:-\$HOME/.shuttle}}/heartbeat.stopped\"
$(respawn_launcher_restart_cmd "$checkout" "$supervisor")"
    # An unsupervised listener needs stopping before a new owner can start.
    [ "$supervisor" != 0 ] || cycle="set -eu; $(daemon_kill)
$(respawn_launcher_restart_cmd "$checkout" "$supervisor")"
  fi
  cycle='[ "${SHUTTLE_ACTIVATION_CYCLED:-0}" != 1 ] || exit 0
'"$cycle"
  activation_window "$(shell_quote "$checkout/shuttle") daemon activate-release $(shell_quote "$EXPECTED_RELEASE") -- bash -c $(shell_quote "$cycle")" "$previous" \
    || { bad "could not activate, verify and release on ${HOST:-local}"; return 1; }
}

built_release() {
  local path="$1/bin/rel"
  [ ! -d "$1/bin/rel-built" ] || path="$1/bin/rel-built"
  if [ -d "$path" ]; then (cd "$path" && pwd -P); else printf '%s\n' "$path"; fi
}

deploy_step() {
  printf '  %s: %s\n' "${HOST:-local}" "$1" >&2
  DEPLOY_STEP=$1
}

host_transaction() { # Runs entirely on the target, under host and tree locks.
  local previous tree cmd before
  deploy_step 'observe previous release'
  DEPLOY_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%S)"
  previous="$(previous_deploy "$SOURCE")"
  deploy_step 'prepare pinned revision'
  bash -c "$(revision_checkout_cmd "$SOURCE" "$previous")" 3>&- 4>&- 5>&- \
    || { bad 'prepare: could not prepare the pinned revision'; return 1; }
  tree="$ROOT/$TARGET_COMMIT"
  if [ "$MODE" = ui ]; then
    deploy_step 'build UI'
    bash -c "cd $(shell_quote "$tree") && make ui" 5>&- \
      || { bad 'build UI: failed'; return 1; }
    cp -R "$tree/ui/dist/." "$SNAPSHOT/" || { bad 'snapshot UI: failed'; return 1; }
    return 0
  fi
  EXPECTED_RELEASE="$(built_release "$tree")" || return 1
  deploy_step 'inspect current release'
  before="$(version_json || true)"
  if target_is_live "$before"; then
    ok "already ready on $TARGET_SHA at $EXPECTED_RELEASE; coalescing without a daemon cycle"
  else
    if [ "$SKIP_UI" = 1 ]; then
      rm -rf "$tree/ui/dist" && mkdir -p "$tree/ui/dist" && cp -R "$STAGE/ui/dist/." "$tree/ui/dist/" \
        || { bad 'ship UI: could not publish the staged bundle'; return 1; }
    fi
    deploy_step 'build/install CLIs'
    cmd="$(build_checkout_cmd "$tree" "$SKIP_UI")"
    case "${BUILD_WRAP%% *}" in
      srun|*/srun)
        case " $BUILD_WRAP " in *' --immediate'*|*' -I'*) ;; *) BUILD_WRAP="$BUILD_WRAP --immediate=900";; esac;;
    esac
    [ -z "$BUILD_WRAP" ] || cmd="$BUILD_WRAP bash -lc $(shell_quote "$cmd")"
    bash -c "$cmd" 5>&- || { bad 'build/install CLIs: failed'; return 1; }
  fi
  if [ -n "$SNAPSHOT" ]; then
    cp -R "$tree/ui/dist/." "$SNAPSHOT/" || { bad 'snapshot UI: failed'; return 1; }
  fi
  if [ -n "$STAGE" ] && [ -f "$STAGE/agents.json" ]; then
    mkdir -p "$HOME/.config/shuttle" && cp "$STAGE/agents.json" "$HOME/.config/shuttle/agents.json" \
      || { bad 'agent registry: could not publish'; return 1; }
  fi
  deploy_step 'config migration'
  bash -c "$(config_migration_cmd)" 3>&- 4>&- 5>&- || { bad 'config migration: failed'; return 1; }
  if ! target_is_live "$before"; then
    deploy_step 'activate/verify/release'
    remote_host_cycle "$tree" "$previous" || { bad 'activate/verify/release: failed'; return 1; }
  else
    deploy_step 'release coalesced daemon'
    activation_window : "$previous" coalesced || return 1
  fi
  deploy_step 'checkout/harness/prune'
  finish_verified_deploy "$SOURCE"
}

target_is_live() {
  version_ready "$1" && [ -z "$(version_launch_health "$1")" ] &&
    [ "$(printf '%s' "$1" | sed -n 's/.*"git_short_sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')" = "$TARGET_SHA" ] &&
    [ "$(printf '%s' "$1" | sed -n 's/.*"release_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')" = "$EXPECTED_RELEASE" ] &&
    { [ -z "$DEPLOY_VERSION" ] ||
      [ "$(printf '%s' "$1" | sed -n 's/.*"mix_vsn"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')" = "$DEPLOY_VERSION" ]; } &&
    VERIFIED_RELEASE_RECEIPT="$(printf '%s' "$1" | python3 -c 'import json,sys; v=json.load(sys.stdin); assert isinstance(v.get("incarnation"),str) and v["incarnation"]; print(json.dumps({k:v[k] for k in ("incarnation","release_path")}))')"
}

transaction_script() {
  local name
  for name in TARGET_COMMIT TARGET_SHA DEPLOY_REF DEPLOY_VERSION BOLD GREEN RED RESET; do
    printf '%s=%s\n' "$name" "$(shell_quote "${!name}")"
  done
  printf 'SHUTTLE_DEPLOY_READY_TIMEOUT_SECONDS=%s\nSHUTTLE_DEPLOY_READY_POLL_INTERVAL_SECONDS=%s\n' \
    "$(shell_quote "${SHUTTLE_DEPLOY_READY_TIMEOUT_SECONDS:-900}")" "$(shell_quote "${SHUTTLE_DEPLOY_READY_POLL_INTERVAL_SECONDS:-5}")"
  printf 'HOST=%s\nSOURCE=%s\nMODE=%s\nSTAGE=%s\nSKIP_UI=%s\nBUILD_WRAP=%s\nSNAPSHOT=%s\n' \
    "$(shell_quote "${1:-local}")" "$(shell_quote "$2")" "$(shell_quote "$3")" \
    "$(shell_quote "$4")" "$(shell_quote "$5")" "$(shell_quote "$6")" "$(shell_quote "$7")"
  declare -f shell_quote ok bad run_local deploy_step deploy_root_cmd seed_deploy_cache_cmd revision_checkout_cmd \
    build_checkout_cmd config_migration_cmd listen_prelude daemon_call version_json previous_deploy \
    version_ready version_launch_health built_release target_is_live wait_for_sha release_quarantine release_verified_deploy finish_verified_deploy verify_and_release activation_window prune_deploy_cmd \
    remember_previous_cmd refresh_checkout_cmd harness_setup_cmd refresh_harnesses supervisor_probe_cmd daemon_listener_cmd disable_competing_supervisors_cmd daemon_kill respawn_launcher_restart_cmd \
    remote_host_cycle host_transaction
  # All subsequent commands are host-local and inherit this login shell's PATH.
  printf '%s\n' 'deploy_step "resolve worktree root"' \
    'ROOT=$(bash -c "$(deploy_root_cmd "$SOURCE")") || exit 1' 'host_transaction'
}

run_transaction() { # host, source, mode, staged files, build wrapper, UI snapshot
  local host="$1" source="$2" mode="$3" stage="$4" wrap="$5" snapshot="$6" skip_ui=0 script bootstrap token status until
  until="${SHUTTLE_DEPLOY_DEADLINE:-$(($(date +%s) + 7200))}"
  token="SHUTTLE_DEPLOY_DONE_${RUN_DIR##*/}-${host:-local}-$mode"
  builds_ui "${host:-local}" || skip_ui=1
  script="$(transaction_script "$host" "$source" "$mode" "$stage" "$skip_ui" "$wrap" "$snapshot")"
  bootstrap="set -eu
HOST=$(shell_quote "${host:-local}")
export SHUTTLE_DEPLOY_DEADLINE=$until
export SHUTTLE_DEPLOY_READY_TIMEOUT_SECONDS=$(shell_quote "${SHUTTLE_DEPLOY_READY_TIMEOUT_SECONDS:-900}")
DEPLOY_STEP=bootstrap
child=''
$(declare -f deploy_step)
finish() {
  status=\$?
  trap - EXIT
  trap '' TERM INT HUP
  if [ -n \"\$child\" ]; then
    kill -TERM \"\$child\" 2>/dev/null || true
    wait \"\$child\" || true
    kill -KILL -- \"-\$child\" 2>/dev/null || true
  fi
  rm -rf $(shell_quote "$stage") || status=1
  printf '\\n  %s: %s: ' \"\$HOST\" \"\$DEPLOY_STEP\"
  if [ \"\$status\" = 0 ]; then printf 'completed\\n'; else printf 'failed (exit %s)\\n' \"\$status\"; fi
  printf '%s %s\\n' \"\$SHUTTLE_DEPLOY_TOKEN\" \"\$status\"
  exit \"\$status\"
}
trap finish EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT
tmp=\$SHUTTLE_DEPLOY_TMP
export SHUTTLE_DEPLOY_LOG_FILE=\"\$tmp/log\"
printf '%s' $(shell_quote "$LOCK_SOURCE") > \"\$tmp/main.go\"
deploy_step 'compile lock helper'
GOMAXPROCS=2 GOFLAGS=-p=2 go build -o \"\$tmp/lock\" \"\$tmp/main.go\" &
child=\$!
wait \"\$child\"
child=''
deploy_step 'acquire host and tree locks'
SHUTTLE_DEPLOY_LOCK_TIMEOUT_SECONDS=$(shell_quote "${SHUTTLE_DEPLOY_LOCK_TIMEOUT_SECONDS:-3600}") \"\$tmp/lock\" \"\$HOME/.shuttle/deploy.lock\" \"\$HOME/.shuttle/deploy/leases/$TARGET_COMMIT.lock\" \
  \"host=${host:-local} target=$TARGET_COMMIT deployer=$DEPLOYER\" bash -c $(shell_quote "$script") <&7 7<&- &
child=\$!
DEPLOY_STEP='host transaction'
wait \"\$child\"
status=\$?
kill -KILL -- \"-\$child\" 2>/dev/null || true
child=''
exit \"\$status\""
  printf '%s' "$bootstrap" > "$RUN_DIR/bootstrap"
  printf '  %s: attached transaction; cancellation follows its observer\n' "${host:-local}" >&2
  exec 6<> "$RUN_DIR/lifetime"
  if [ -z "$host" ]; then
    env SHUTTLE_DEPLOY_DEADLINE="$until" "$LOCAL_TOOL/lock" --observe "$RUN_DIR/bootstrap" "$token" bash -c "$RUN_SOURCE" -- "$token" < "$RUN_DIR/lifetime" 6>&- &
  else
    env SHUTTLE_DEPLOY_DEADLINE="$until" "$LOCAL_TOOL/lock" --observe "$RUN_DIR/bootstrap" "$token" ssh -o BatchMode=yes \
      $(fleet_flags "$host") "$(fleet_ssh "$host")" "bash -c $(shell_quote "$RUN_SOURCE") -- $(shell_quote "$token")" < "$RUN_DIR/lifetime" 6>&- &
  fi
  active=$!
  wait "$active"
  status=$?
  exec 6>&-
  kill -KILL -- "-$active" 2>/dev/null || true
  active=''
  [ "$status" = 0 ] || { bad "attached transaction failed (exit $status); see ~/.shuttle/deploy/last-run.log"; return 1; }
}

deploy_remote() {
  local host="$1" dir dest flags stage
  dir="$(fleet_dir "$host")"; dest="$(fleet_ssh "$host")"; flags="$(fleet_flags "$host")"
  say "$host ($dest:$dir)"
  ssh $flags "$dest" true || try_handshake "$host" \
    || { bad 'ssh: could not establish a connection'; return 1; }
  stage="$(run_value "$host" 'mktemp -d')" || { bad 'stage: failed'; return 1; }
  if ! builds_ui "$host"; then
    ship_ui "$dest" "$stage" "$flags" || return 1
  fi
  if [ -f "$AGENTS_FILE" ]; then
    rsync -az -e "ssh $flags" "$AGENTS_FILE" "$dest:$stage/agents.json" \
      || { bad 'stage agent registry: failed'; return 1; }
  fi
  run_transaction "$host" "$dir" deploy "$stage" "$(fleet_build_wrap "$host")" ""
}

LOCK_SOURCE="$(<"$REPO/scripts/deploy-lock/main.go")"
RUN_SOURCE="$(<"$REPO/scripts/deploy-run.sh")"
DEPLOYER="$(hostname):$$"
RUN_DIR="$(mktemp -d)" || exit 1
mkfifo "$RUN_DIR/lifetime" || exit 1
LOCAL_TOOL= active=
cleanup() { rm -rf "$RUN_DIR" "$LOCAL_TOOL"; }
cancel_deploy() {
  trap '' TERM INT HUP
  exec 6>&-
  if [ -n "$active" ]; then kill -TERM "$active" 2>/dev/null || true; wait "$active" || true; kill -KILL -- "-$active" 2>/dev/null || true; fi
  exit "$1"
}
trap cleanup EXIT
trap 'cancel_deploy 143' TERM HUP
trap 'cancel_deploy 130' INT
mkdir -p "$HOME/.shuttle/deploy/tools" || exit 1
LOCAL_TOOL=$(mktemp -d "$HOME/.shuttle/deploy/tools/lock.XXXXXX") || exit 1
printf '%s' "$LOCK_SOURCE" > "$LOCAL_TOOL/main.go"
GOMAXPROCS=2 GOFLAGS=-p=2 go build -o "$LOCAL_TOOL/lock" "$LOCAL_TOOL/main.go" || exit 1
UI_SNAPSHOT="$RUN_DIR/ui"
mkdir -p "$UI_SNAPSHOT"

FAILED=""
for h in $HOSTS; do
  HOST="$h"
  if [ "$h" = local ]; then deploy_local || FAILED="$FAILED $h"
  else deploy_remote "$h" || FAILED="$FAILED $h"; fi
done

echo
if [ -z "$FAILED" ]; then
  printf '%s✓ fleet on %s%s\n' "$GREEN$BOLD" "$TARGET_SHA" "$RESET"
else
  printf '%s✗ failed:%s%s\n' "$RED$BOLD" "$FAILED" "$RESET"; exit 1
fi
