#!/usr/bin/env bash
# Deploy a source revision: build, refresh plugins, restart once, verify, release.
# Usage: bin/shuttle-deploy [--hosts local,hub-a] [--ref REV] [--no-push]
#        bin/shuttle-deploy --list | --handshake | --help
# Fleet entries come from SHUTTLE_REMOTES_FILE or ~/.config/shuttle/remotes.json.
# Python 3 is needed only on the deploy host, for structured API responses.
set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FLEET_FILE="${SHUTTLE_REMOTES_FILE:-$HOME/.config/shuttle/remotes.json}"
PUSH=1 HANDSHAKE=0 DEPLOY_REF=HEAD
ok() { printf '  %s\n' "$*"; }
bad() { printf '  %s: %s\n' "${HOST:-deploy}" "$*" >&2; }
shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

read_fleet() {
  [ -f "$FLEET_FILE" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '(if type == "array" then . else .remotes end // [])
           | .[]
           | select(.enabled != false)
           | select((.checkout // "") != "")
           | [.name, (.ssh // .name), .checkout, (.auth // "pubkey"),
              ((.ssh_flags // []) | join(" ")),
              (if .build_ui == false then "0" else "1" end), (.build_wrap // "")]
           | @tsv' "$FLEET_FILE"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$FLEET_FILE" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
for r in (doc if isinstance(doc, list) else doc.get("remotes") or []):
    if r.get("enabled") is False or not r.get("checkout"):
        continue
    print("\t".join([r.get("name", ""), r.get("ssh") or r.get("name", ""),
                     r["checkout"], r.get("auth") or "pubkey",
                     " ".join(r.get("ssh_flags") or []),
                     "0" if r.get("build_ui") is False else "1", r.get("build_wrap") or ""]))
PY
  else
    echo "shuttle-deploy: need jq or python3 to read $FLEET_FILE" >&2
    return 1
  fi
}

FLEET_TSV="$(read_fleet)" || exit 1
FLEET_ORDER="local $(printf '%s\n' "$FLEET_TSV" | awk -F'\t' 'NF {print $1}')"
fleet_row() { printf '%s\n' "$FLEET_TSV" | awk -F'\t' -v h="$1" '$1 == h'; }
fleet_dir() { if [ "$1" = local ]; then printf '%s\n' "$REPO"; else fleet_row "$1" | cut -f3; fi; }
fleet_ssh() { fleet_row "$1" | cut -f2; }
fleet_auth() { fleet_row "$1" | cut -f4; }
fleet_flags() { fleet_row "$1" | cut -f5; }
fleet_build_wrap() { fleet_row "$1" | cut -f7; }
builds_ui() { [ "$(fleet_row "$1" | cut -f6)" != 0 ]; }
try_handshake() { # $1 = host; returns 0 with a live master, 1 otherwise
  local host="$1" dest sess="shuttle-handshake-$1"
  [ "$(fleet_auth "$host")" = "interactive" ] || return 1
  [ "$HANDSHAKE" = 1 ] || { bad "no live ControlMaster; rerun with --handshake (a human must approve the prompt)"; return 1; }
  dest="$(fleet_ssh "$host")"
  tmux kill-session -t "$sess" 2>/dev/null
  tmux new-session -d -s "$sess" "ssh $dest" || { bad "could not open tmux for handshake"; return 1; }
  sleep 5
  tmux send-keys -t "$sess" "${SHUTTLE_HANDSHAKE_REPLY:-1}" Enter
  printf '  %s…%s auth prompt answered — approve the push if one was sent (times out in ~60s)\n' "" ""
  for _ in $(seq 1 25); do
    ssh -O check "$dest" 2>/dev/null && { ok "ControlMaster live"; tmux kill-session -t "$sess" 2>/dev/null; return 0; }
    sleep 3
  done
  bad "handshake timed out (prompt not approved?)"
  tmux kill-session -t "$sess" 2>/dev/null
  return 1
}

HOSTS="$FLEET_ORDER"
while [ $# -gt 0 ]; do
  case "$1" in
    --hosts|--ref)
      [ $# -ge 2 ] && [ -n "$2" ] || { bad "$1 needs a value"; exit 2; }
      if [ "$1" = --hosts ]; then HOSTS="${2//,/ }"; else DEPLOY_REF="$2"; fi; shift 2 ;;
    --hosts=*) HOSTS="${1#*=}"; HOSTS="${HOSTS//,/ }"; shift ;;
    --ref=*) DEPLOY_REF="${1#*=}"; shift ;;
    --no-push) PUSH=0; shift ;;
    --handshake) HANDSHAKE=1; shift ;;
    --list)
      for h in $FLEET_ORDER; do printf '%-16s %-16s %s\n' "$h" "$(fleet_ssh "$h")" "$(fleet_dir "$h")"; done
      exit 0 ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# *//'; exit 0 ;;
    *) bad "unknown flag: $1"; exit 2 ;;
  esac
done
[ -n "$HOSTS" ] || { bad 'no hosts selected'; exit 2; }
for h in $HOSTS; do
  [ -n "$(fleet_dir "$h")" ] || { bad "unknown host: $h (see --list)"; exit 2; }
done
command -v python3 >/dev/null || { bad 'python3 is required on the deploy host'; exit 1; }
TARGET_COMMIT="$(git -C "$REPO" rev-parse --verify "$DEPLOY_REF^{commit}")" || exit 1
TARGET_SHA="${TARGET_COMMIT:0:7}"
DEPLOY_VERSION=""
if [[ "$DEPLOY_REF" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)$ ]]; then DEPLOY_VERSION="${BASH_REMATCH[1]}"; fi
if [ "$PUSH" = 1 ]; then
  if [ "$DEPLOY_REF" = HEAD ]; then git -C "$REPO" push; else git -C "$REPO" push origin "$DEPLOY_REF"; fi || exit 1
fi
warn_target_ci() {
  "$REPO/scripts/ci-status-hook.sh" "$TARGET_COMMIT" || true
}

warn_target_ci


run_on() { # Configured SSH flags also apply to every probe and file transfer.
  if [ "$1" = local ]; then bash -lc "$2"
  else ssh $(fleet_flags "$1") "$(fleet_ssh "$1")" "bash -lc $(shell_quote "$2")"; fi
}
json_field() { python3 -c 'import json,sys; v=json.load(sys.stdin).get(sys.argv[1]); print("" if v is None else str(v))' "$1"; }
listen_prelude() {
  printf '%s' 'l=; dd=; command -v felt >/dev/null 2>&1 || { echo "felt is not on PATH" >&2; exit 3; }; '
  printf '%s' 'command -v shuttle >/dev/null 2>&1 || { echo "shuttle is not on PATH" >&2; exit 3; }; '
  printf '%s' 'out=$(shuttle host --json 2>&1) || { echo "cannot resolve the daemon listen address: $out" >&2; exit 3; }; '
  printf '%s' 'dd=$(printf "%s\n" "$out" | sed -n '"'"'s/.*"data_dir": *"\([^"]*\)".*/\1/p'"'"' | head -n 1); '
  printf '%s' 'l=$(printf "%s\n" "$out" | sed -n '"'"'s/.*"listen": *"\([^"]*\)".*/\1/p'"'"' | head -n 1); '
  printf '%s' 'sock=; port=4000; '
  printf '%s' 'case "$l" in unix://?*) sock="${l#unix://}";; tcp://127.0.0.1:*) port="${l##*:}";; *) echo "unsupported daemon listen address: $l" >&2; exit 3;; esac; '
  printf '%s' 'base=http://127.0.0.1:$port; [ -n "$sock" ] && base=http://localhost; '
}

daemon_call() { # The host owns endpoint resolution and identity checks.
  listen_prelude
  printf '%s' 'shuttle host check-owner && '
  printf '%s' "curl -fsS --max-time 10 $1"' ${sock:+--unix-socket "$sock"} "$base'"$2"'"'
}

version_json() { run_on "$1" "$(daemon_call '' /api/v1/version)"; }
prepare_tree() { # Immutable roots protect running BEAMs on network filesystems.
  cat <<SH
set -eu
source=$(shell_quote "$1")
previous=$(shell_quote "${2:-}")
common=\$(git -C "\$source" rev-parse --git-common-dir)
case "\$common" in /*) ;; *) common="\$source/\$common" ;; esac
root=\$(dirname "\$(cd "\$common" && pwd -P)").deploy
target="\$root/$TARGET_COMMIT"
git -C "\$source" fetch -q origin "$TARGET_COMMIT"
if [ ! -d "\$target" ]; then
  git -C "\$source" worktree add --detach "\$target" "$TARGET_COMMIT" >&2
  # Copy only disposable caches; a missing cache means a cold build.
  for cache in daemon/deps daemon/_build ui/node_modules; do
    [ -d "\$previous/\$cache" ] && [ ! -L "\$previous/\$cache" ] || continue
    mkdir -p "\$target/\$cache"
    cp -pRP "\$previous/\$cache/." "\$target/\$cache/" || { rm -rf "\$target/\$cache"; echo "cache copy failed; building cold" >&2; }
  done
  if [ -f "\$target/ui/node_modules/.npm-ci-stamp" ]; then
    if cmp -s "\$previous/ui/package-lock.json" "\$target/ui/package-lock.json"; then
      touch "\$target/ui/node_modules/.npm-ci-stamp"
    else
      rm -f "\$target/ui/node_modules/.npm-ci-stamp"
    fi
  fi
fi
[ "\$(git -C "\$target" rev-parse HEAD)" = "$TARGET_COMMIT" ]
[ -z "\$(git -C "\$target" status --porcelain --untracked-files=no)" ]
printf '%s\\n' "\$target"
SH
}
build_cmd() {
  printf 'cd %s && ' "$(shell_quote "$1")"
  if [ -n "$DEPLOY_VERSION" ]; then
    printf 'export SHUTTLE_VERSION=%s GOFLAGS=%s; ' "$(shell_quote "$DEPLOY_VERSION")" "$(shell_quote "'-ldflags=-X=main.version=$DEPLOY_VERSION -X=main.commit=$TARGET_COMMIT'")"
  fi
  printf 'make build'
  builds_ui "$2" || printf ' SKIP_UI=1'
}
LOCAL_UI_TREE=""
ship_ui() { # Network-home hosts receive the bundle before release assembly.
  if [ -z "$LOCAL_UI_TREE" ]; then
    LOCAL_UI_TREE="$(run_on local "$(prepare_tree "$REPO")")" || return 1
    run_on local "cd $(shell_quote "$LOCAL_UI_TREE") && make ui" || return 1
  fi
  run_on "$1" "mkdir -p $(shell_quote "$2/ui/dist")" || return 1
  rsync -az --delete -e "ssh $(fleet_flags "$1")" "$LOCAL_UI_TREE/ui/dist/" "$(fleet_ssh "$1"):$2/ui/dist/"
}
restart_cmd() { # Exactly one owner cycles the process; installation owns service settings.
  cat <<SH
set -eu
checkout=$(shell_quote "$1")
if shuttle daemon loop-present >/dev/null 2>&1; then
  # The canonical launcher and repo pointer let the next login identify this loop.
  mkdir -p "\$HOME/.local/bin" "\$HOME/.shuttle"
  install -m 755 "\$checkout/bin/shuttle-launch" "\$HOME/.local/bin/shuttle-launch"
  printf '%s\\n' "\$checkout" > "\$HOME/.shuttle/repo"
  SHUTTLE_DIR="\$checkout" "\$HOME/.local/bin/shuttle-launch" --tmux
else
  SHUTTLE_RELEASE="\$checkout/bin/rel" shuttle daemon install --preserve
fi
SH
}
wait_for_sha() {
  local host="$1" previous="$2" version elapsed=0
  local timeout="${SHUTTLE_DEPLOY_READY_TIMEOUT_SECONDS:-900}" interval="${SHUTTLE_DEPLOY_READY_POLL_INTERVAL_SECONDS:-5}"
  case "$timeout" in ''|*[!0-9]*) bad 'invalid ready timeout'; return 1 ;; esac
  case "$interval" in ''|*[!0-9]*|0) bad 'invalid poll interval'; return 1 ;; esac
  local started="$(date +%s)"
  while :; do
    version="$(version_json "$host" 2>/dev/null || true)"
    if printf '%s' "$version" | python3 -c '
import datetime,json,sys
try:
    v=json.load(sys.stdin)
    boot=datetime.datetime.fromisoformat(v["booted_at"].replace("Z","+00:00"))
    old=datetime.datetime.fromisoformat(sys.argv[2].replace("Z","+00:00"))
    valid=(v.get("git_sha")==sys.argv[1] and v.get("ready") is True and boot>old)
    if sys.argv[3]: valid=valid and v.get("mix_vsn")==sys.argv[3]
    sys.exit(0 if valid else 1)
except (ValueError,KeyError,TypeError): sys.exit(1)
' "$TARGET_COMMIT" "$previous" "$DEPLOY_VERSION"; then return 0; fi
    elapsed=$(( $(date +%s) - started ))
    [ "$elapsed" -lt "$timeout" ] || { bad "verify: no fresh ready boot on $TARGET_SHA within ${timeout}s"; return 1; }
    [ $((elapsed % 30)) -ge "$interval" ] || ok "waiting for a fresh ready boot (${elapsed}s)"
    sleep "$interval"
  done
}
prune_cmd() { # Keep the current, previous and two newest roots, plus Pi sources.
  cat <<SH
set -eu
current=$(shell_quote "$1")
previous=$(shell_quote "$2")
root=\$(dirname "\$current")
packages=
if command -v pi >/dev/null 2>&1; then packages=\$(pi list) || exit 1; fi
count=0
ls -dt "\$root"/* | while IFS= read -r tree; do
  [ -d "\$tree" ] || continue
  count=\$((count + 1))
  [ "\$count" -gt 2 ] || continue
  [ "\$tree" != "\$current" ] && [ "\$tree" != "\$previous" ] || continue
  printf '%s\\n' "\$packages" | grep -Fq "    \$tree" && continue
  git -C "\$current" worktree remove --force "\$tree"
done
SH
}
deploy_host() {
  local host="$1" source tree before previous old_sha cmd wrap harness_failed=0
  if [ "$host" != local ]; then
    run_on "$host" true || try_handshake "$host" || { bad 'ssh: unreachable; authenticate first'; return 1; }
  fi
  before="$(version_json "$host")" || { bad 'preflight: daemon does not answer'; return 1; }
  previous="$(printf '%s' "$before" | json_field booted_at)" || return 1
  old_sha="$(printf '%s' "$before" | json_field git_sha)" || return 1
  [ -n "$previous" ] && [ -n "$old_sha" ] || { bad 'preflight: daemon identity incomplete'; return 1; }
  source="$(fleet_dir "$host")"
  tree="$(run_on "$host" "$(prepare_tree "$source" "${source}.deploy/$old_sha")")" || { bad 'prepare: failed'; return 1; }
  if ! builds_ui "$host"; then ship_ui "$host" "$tree" || { bad 'ship UI: failed'; return 1; }; fi
  cmd="$(build_cmd "$tree" "$host")"
  wrap="$(fleet_build_wrap "$host")"
  [ -z "$wrap" ] || cmd="$wrap bash -lc $(shell_quote "$cmd")"
  run_on "$host" "$cmd" || { bad 'build: failed'; return 1; }
  if [ "$host" = local ]; then LOCAL_UI_TREE="$tree"; fi
  run_on "$host" "felt setup refresh --source $(shell_quote "$tree")" || harness_failed=1
  run_on "$host" "$(restart_cmd "$tree")" || { bad 'restart: failed'; return 1; }
  wait_for_sha "$host" "$previous" || return 1
  # Use the CLI's HTTP result; JSON whitespace cannot turn success into failure.
  run_on "$host" 'shuttle daemon release' || { bad 'release: failed'; return 1; }
  run_on "$host" "$(prune_cmd "$tree" "$(dirname "$tree")/$old_sha")" || { bad 'prune: failed'; return 1; }
  [ "$harness_failed" = 0 ] || { bad 'harness refresh: failed (daemon is deployed and released)'; return 1; }
  ok "live on $TARGET_SHA, ready and released"
}
FAILED=""
for HOST in $HOSTS; do
  printf '\n%s (%s)\n' "$HOST" "$TARGET_SHA"
  deploy_host "$HOST" || FAILED="$FAILED $HOST"
done
if [ -n "$FAILED" ]; then bad "failed hosts:$FAILED"; exit 1; fi
ok "fleet on $TARGET_SHA"
