<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shuttle daemon LaunchAgent, rendered from a template at install time by
  `shuttle install-agent` (in a checkout, `make install-agent` is a wrapper
  over the same command and the same template). The placeholders
  __SHUTTLE_DIR__ / __LOG__ / __FELT_STORES__ / __PATH__ / __SSH_AUTH_SOCK__
  are filled in then; the unrendered template is not a valid plist, so don't
  load it directly.

  __SHUTTLE_DIR__ is whatever directory holds bin/shuttle — the unpacked
  release for a downloaded tarball, the repository root for a checkout.
  `exec` replaces the shell with the daemon so launchd's KeepAlive supervises
  it directly, and `start --force` skips the already-running guard so a
  restart never refuses.

  PATH. launchd starts with a near-empty environment, and the daemon shells out
  to `felt` for every store walk — a PATH missing `felt` yields `:enoent` → 500
  on /api/v1/fibers/composite: the board loads, the kanban does not. Boot
  itself no longer needs anything, since the daemon is an ERTS-bundled Mix
  release with no `#!/usr/bin/env escript` shebang hunting for escript/erl
  (which, under launchd's bare env, used to exit 127). That narrows the
  requirement to `felt`; it does not remove it. Running a login shell at
  runtime does NOT fix what's left: starting from launchd's bare env, the user
  profile doesn't reconstruct the login PATH (its setup isn't self-sufficient
  from `env -i`). So install-agent CAPTURES the login PATH once, at install
  time, from a login shell run in a scrubbed environment — scrubbed so the
  installing session's own PATH can't leak in — and bakes it into __PATH__
  below. Deterministic at runtime, and the user's real PATH rather than a
  hand-maintained list. `--path` overrides it.

  Keep BOTH the shuttle directory and the felt stores outside ~/Documents,
  ~/Desktop and ~/Downloads. macOS TCC blocks launchd-spawned processes from
  those folders, and Full Disk Access does NOT inherit across launchd's process
  tree the way it does under a terminal app — so a daemon rooted in a protected
  folder crash-loops, and stores in one are silently walked as empty, unless
  you grant FDA to every binary in the tree (beam.smp, felt, …). Staying
  outside them sidesteps TCC entirely: zero grants, survives erlang upgrades.
  install-agent warns about either path. (Earlier this template used `-c` +
  no-exec + an FDA grant on /bin/bash to keep bash as the responsible process;
  that umbrella does not actually inherit under launchd — relocating out of the
  protected folders is the fix.)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec '__SHUTTLE_DIR__/bin/shuttle' start --force</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- The user's real login PATH, captured at install time (see header). -->
        <key>PATH</key>
        <string>__PATH__</string>
        <!--
          SHUTTLE_PORT is normally absent (the daemon binds 4000). It exists so a
          SECOND, non-default instance can be supervised beside the real one —
          which is what makes the keep-alive path testable on a machine that is
          already running a daemon, instead of only renderable. The renderer
          drops this pair when no port is given.
        -->
        <key>SHUTTLE_PORT</key>
        <string>__PORT__</string>
        <!--
          FELT_STORES scopes the daemon's felt polling to the stores named at
          install time (`--felt-stores`). felt re-discovers each project's
          substores by following the symlinks under a store's .felt/, so a
          single aggregate store is usually the only entry you need. Keep them
          outside the TCC-protected folders (see header). (Set in launchd's
          environment rather than the login profile, since the scoping is ours
          — a login shell inherits it across the `-l`.)
        -->
        <key>FELT_STORES</key>
        <string>__FELT_STORES__</string>
        <!--
          SSH_AUTH_SOCK points at the user's PERSISTENT login ssh-agent (default
          ~/.ssh/agent.sock), NOT launchd's per-session Keychain agent. This is
          load-bearing for remote work: launchd hands the daemon a bare agent
          that only ever holds the default key, so credentials added to the real
          agent — notably a short-lived SSH certificate from a step-ca host
          (`step ssh login …`, see AGENTS.md) — are invisible to it. Without
          this, every fresh ssh the daemon makes to such a host fails auth: its own
          remote feed/tunnel can't connect, and a kanban Attach tab (which
          inherits this very SSH_AUTH_SOCK) opens and instantly dies. Override
          with `--ssh-auth-sock` if your socket lives elsewhere.
        -->
        <key>SSH_AUTH_SOCK</key>
        <string>__SSH_AUTH_SOCK__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__SHUTTLE_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG__</string>

    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
