{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/session.sh\"; [ ! -x \"$p\" ] || \"$p\""
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/handoff.sh\"; [ ! -x \"$p\" ] || \"$p\""
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/remind.sh\"; [ ! -x \"$p\" ] || \"$p\""
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/handoff.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/touch.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/event.sh\"; [ ! -x \"$p\" ] || \"$p\""
          }
        ]
      }
    ]
  }
}
