{
  "name": "shuttle-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Shuttle UI — a lean web client for the Shuttle daemon (:4000): kanban board, Stash/Capture, and a fiber/file viewer. Served by the daemon as a static bundle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "TZ=America/Los_Angeles vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && npm run harness:board && npm run harness:change && node e2e/run.mjs",
    "e2e:change": "npm run harness:change && node e2e/changeSmoke.mjs",
    "harness:change": "node scripts/bake-change-fixture.mjs && vite build -c vite.harness-change.config.ts",
    "harness:board": "node scripts/bake-change-fixture.mjs && vite build -c vite.harness-board.config.ts",
    "perf": "npm run harness:board && node e2e/performance.mjs",
    "perf:typing": "npm run harness:board && node e2e/typing.mjs",
    "screenshots:docs": "npm run harness:board && node scripts/capture-docs.mjs",
    "video:docs": "node scripts/render-tour.mjs",
    "lifecycle:model": "UPDATE_LIFECYCLE_MODEL=1 TZ=America/Los_Angeles vitest run test/lifecycleModel.test.ts"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/web": "0.1.0-beta.1",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "marked": "^17.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.62.1",
    "postcss": "8.5.26",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "4.1.10"
  }
}
