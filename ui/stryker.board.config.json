{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.board.config.ts", "related": false },
  "mutate": [
    "src/**/*.ts", "src/**/*.tsx", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/**/*.d.ts",
    "!src/board/keymap.ts", "!src/board/workspace/bodyLinks.ts", "!src/board/workspace/ChannelReferences.ts",
    "!src/board/workspace/DocumentBridge.ts", "!src/board/workspace/PhoneGestures.ts",
    "!src/board/workspace/reportMentions.ts", "!src/board/workspace/route.ts", "!src/runtime/uncachedQueries.ts",
    "!src/board/workspace/ChannelThemes.ts"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "concurrency": 2,
  "timeoutMS": 10000,
  "dryRunTimeoutMinutes": 20,
  "reporters": ["json", "progress-append-only"],
  "jsonReporter": { "fileName": "reports/mutation/board.json" }
}
